# Shris AI — Lead Capture & Voice Platform Environment

# Lead capture (configure at least one channel for production form submissions)
# Option A: Webhook (Zapier, Make, HubSpot, custom CRM)
LEAD_WEBHOOK_URL=

# Option B: Email notifications via Resend (https://resend.com)
# Requires a verified domain for CONTACT_EMAIL_FROM, or use onboarding@resend.dev for testing.
RESEND_API_KEY=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=Shris AI Leads <onboarding@resend.dev>

# Voice platform API (production). For local dev against the Shris AI runtime,
# use http://127.0.0.1:8787/v1 instead.
VOICE_SERVICE_API_KEY=your_voice_api_key_here
PUBLIC_VOICE_API_ENDPOINT=https://api.shris.ai/v1
