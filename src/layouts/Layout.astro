---
import '../styles/global.css';
import DemoModal from '../components/modals/DemoModal.astro';
import VoiceWidget from '../components/voice/VoiceWidget.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Shris AI | Sovereign Enterprise Voice Platform',
  description = 'Autonomous enterprise AI voice workforce platform engineered by Thejands LLP. Full-duplex conversational voice agents for inbound support, outbound qualification, and business workflow automations.',
  ogImage = '/og-image.svg'
} = Astro.props;

const isApp = Astro.url.pathname.startsWith('/app');
const isDocs = Astro.url.pathname.startsWith('/docs');
const htmlClass = [isDocs || isApp ? 'surface-aa' : '', isApp ? 'app-console' : ''].filter(Boolean).join(' ');
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://shris.thejands.in');

// Rich Schema.org Graph for SEO, EEO & GEO (Answer Engines)
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://shris.thejands.in/#organization',
      'name': 'Thejands LLP',
      'alternateName': 'Shris AI',
      'url': 'https://shris.thejands.in',
      'logo': 'https://shris.thejands.in/favicon.svg',
      'description': 'Pioneering sovereign voice intelligence and conversational AI workforce platforms in India.',
      'foundingDate': '2024',
      'address': {
        '@type': 'PostalAddress',
        'addressCountry': 'IN'
      },
      'sameAs': [
        'https://github.com/Mjeevanantham/shris-ai',
        'https://linkedin.com/company/shris-ai'
      ]
    },
    {
      '@type': 'WebSite',
      '@id': 'https://shris.thejands.in/#website',
      'url': 'https://shris.thejands.in',
      'name': 'Shris AI | Sovereign Voice Platform',
      'publisher': {
        '@id': 'https://shris.thejands.in/#organization'
      }
    },
    {
      '@type': 'SoftwareApplication',
      '@id': 'https://shris.thejands.in/#software',
      'name': 'Shris AI Sovereign Conversational Engine',
      'applicationCategory': 'BusinessApplication',
      'operatingSystem': 'Cloud, Any',
      'offers': {
        '@type': 'Offer',
        'price': '0',
        'priceCurrency': 'INR',
        'description': 'Enterprise pay-per-connected-minute pricing'
      },
      'featureList': [
        'Sub-300ms Full-Duplex Speech Latency',
        '10+ Regional Indian Dialects and Accents',
        'Real-Time Autonomous Tool Calling & CRM Updates',
        'Zero Data Retention and Sovereign Compute Isolation',
        'Direct SIP Trunking and Telephony Integration'
      ]
    }
  ]
};
---

<!doctype html>
<html lang="en" class={htmlClass}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Search Engine & GEO Meta Tags -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content="Thejands LLP" />
    <meta name="publisher" content="Thejands LLP" />
    <meta name="keywords" content="AI voice agents, sovereign voice platform, telephony AI, automated outbound calls, speech intelligence India, conversational AI workforce, real estate AI calling, BFSI voice bot" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Shris AI" />

    <!-- Twitter Card -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    {isApp ? null : (
      <>
        <link rel="preload" href="/fonts/plus-jakarta-latin.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
        <link rel="stylesheet" href="/fonts.css" />
      </>
    )}

    <!-- JSON-LD Structured Data for Search & Answer Engines -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body data-voice-api={import.meta.env.PUBLIC_VOICE_API_ENDPOINT ?? 'http://127.0.0.1:8787/v1'}>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />

    {isApp ? null : <DemoModal />}
    {isApp ? null : <VoiceWidget />}

    {!isApp && (
    <script>
      import { initInteractiveDemos } from '../scripts/interactive-demos';

      document.addEventListener('DOMContentLoaded', () => {
        const startDemos = () => initInteractiveDemos();
        if ('requestIdleCallback' in window) {
          requestIdleCallback(startDemos, { timeout: 900 });
        } else {
          setTimeout(startDemos, 1);
        }

        const heavy = !location.pathname.startsWith('/docs');
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!heavy || reduced) return;
        const boot = () => {
          void Promise.all([
            import('../scripts/lenis-scroll'),
            import('../scripts/animations')
          ]).then(([{ initSmoothScroll }, { initGsapAnimations }]) => {
            initSmoothScroll();
            initGsapAnimations();
          });
        };
        const afterLoad = () => {
          if ('requestIdleCallback' in window) {
            requestIdleCallback(boot, { timeout: 2200 });
          } else {
            setTimeout(boot, 50);
          }
        };
        if (document.readyState === 'complete') afterLoad();
        else window.addEventListener('load', afterLoad, { once: true });
      });
    </script>
    )}
  </body>
</html>
