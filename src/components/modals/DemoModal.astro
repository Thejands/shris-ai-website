---
---

<div id="demo-modal" class="modal-overlay" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="modal-title">
  <div class="modal-backdrop" id="modal-backdrop-close"></div>

  <div class="modal-container card-dark">
    <!-- Close Button -->
    <button class="modal-close-btn" id="modal-close-btn" aria-label="Close modal">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Modal Header -->
    <div class="modal-header-box">
      <div class="badge badge-indigo" style="margin-bottom: 0.5rem;">Enterprise Access</div>
      <h3 id="modal-title" class="modal-title">Book an Architecture Demo</h3>
      <p class="modal-sub">
        Experience live sovereign voice calling configured for your specific enterprise workflow.
      </p>
    </div>

    <!-- Active Form View -->
    <form id="enterprise-demo-form" class="modal-form">
      <div class="form-row-2">
        <div class="form-field">
          <label for="demo-first-name">Full Name *</label>
          <input type="text" id="demo-first-name" required placeholder="Aarav Mehta" class="custom-input" />
        </div>
        <div class="form-field">
          <label for="demo-work-email">Work Email *</label>
          <input type="email" id="demo-work-email" required placeholder="aarav@company.com" class="custom-input" />
        </div>
      </div>

      <div class="form-row-2">
        <div class="form-field">
          <label for="demo-phone">Phone Number (For Live Test Call) *</label>
          <input type="tel" id="demo-phone" required placeholder="+91 98765 43210" class="custom-input" />
        </div>
        <div class="form-field">
          <label for="demo-company">Company / Organization *</label>
          <input type="text" id="demo-company" required placeholder="Tata Digital / HDFC" class="custom-input" />
        </div>
      </div>

      <div class="form-field">
        <label for="demo-industry">Primary Industry Workflow</label>
        <select id="demo-industry" class="custom-select">
          <option value="real-estate">Real Estate (Lead Qualification & Site Visits)</option>
          <option value="bfsi">BFSI & Fintech (EMI Reminders & KYC Verification)</option>
          <option value="healthcare">Healthcare (Doctor Consultations & Follow-ups)</option>
          <option value="retail">E-Commerce & Retail (Order Confirmation & NDR)</option>
          <option value="logistics">Logistics & Supply Chain (Driver & Delivery Dispatch)</option>
          <option value="other">Custom Enterprise Telephony Workflow</option>
        </select>
      </div>

      <div class="form-field">
        <label>Estimated Monthly Call Volume</label>
        <div class="volume-selector-pills">
          <label class="vol-pill">
            <input type="radio" name="call-volume" value="10k-50k" checked />
            <span>10k – 50k</span>
          </label>
          <label class="vol-pill">
            <input type="radio" name="call-volume" value="50k-250k" />
            <span>50k – 250k</span>
          </label>
          <label class="vol-pill">
            <input type="radio" name="call-volume" value="250k-1m" />
            <span>250k – 1M</span>
          </label>
          <label class="vol-pill">
            <input type="radio" name="call-volume" value="1m+" />
            <span>1M+</span>
          </label>
        </div>
      </div>

      <button type="submit" id="demo-submit-btn" class="btn btn-indigo btn-lg" style="width: 100%; margin-top: 0.75rem;">
        <span>Schedule Live Demo & Architecture Review</span>
      </button>

      <p class="form-footnote">
        Protected by Thejands LLP Enterprise Security. Zero spam, NDA guaranteed.
      </p>
    </form>

    <!-- Success Confirmation State (Replaces alert) -->
    <div id="demo-success-state" class="modal-success-box" style="display: none;">
      <div class="success-icon-wrap">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2.5">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </div>
      <h3 class="success-title">Demo Request Received</h3>
      <p class="success-desc">
        Thank you! Our enterprise voice engineering team is reviewing your requirements and will reach out to schedule your live architecture session.
      </p>
      <div class="success-meta-card">
        <span class="pulse-dot"></span>
        <span>Priority queue assigned • Response within 2 business hours</span>
      </div>
      <button type="button" id="modal-success-done-btn" class="btn btn-filled btn-md" style="margin-top: 1.5rem;">
        Done
      </button>
    </div>
  </div>
</div>

<style>
  .modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }

  .modal-overlay.active {
    display: flex;
  }

  .modal-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(11, 14, 23, 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .modal-container {
    position: relative;
    z-index: 2;
    max-width: 640px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    background: var(--shris-navy-900);
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(99, 102, 241, 0.2);
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    border-radius: var(--radius-2xl);
    animation: modal-pop 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes modal-pop {
    0% {
      opacity: 0;
      transform: scale(0.95) translateY(10px);
    }
    100% {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .modal-close-btn {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #94A3B8;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .modal-close-btn:hover {
    background: rgba(255, 255, 255, 0.16);
    color: #FFFFFF;
  }

  .modal-header-box {
    margin-bottom: 1.75rem;
    padding-right: 2rem;
  }

  .modal-title {
    font-size: 1.75rem;
    color: #FFFFFF;
    margin-bottom: 0.35rem;
  }

  .modal-sub {
    font-size: 0.9rem;
    color: #94A3B8;
    line-height: 1.5;
    margin: 0;
  }

  .modal-form {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-field label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: #CBD5E1;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .custom-input, .custom-select {
    width: 100%;
    padding: 0.75rem 1rem;
    background: #0B0E17;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-md);
    color: #FFFFFF;
    font-family: var(--font-body);
    font-size: 0.9rem;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .custom-input:focus, .custom-select:focus {
    border-color: #6366F1;
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.25);
  }

  .volume-selector-pills {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.5rem;
  }

  .vol-pill {
    position: relative;
    cursor: pointer;
  }

  .vol-pill input {
    position: absolute;
    opacity: 0;
  }

  .vol-pill span {
    display: block;
    text-align: center;
    padding: 0.5rem 0.25rem;
    background: #0B0E17;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: #94A3B8;
    transition: all 0.2s ease;
  }

  .vol-pill input:checked + span {
    background: rgba(99, 102, 241, 0.2);
    border-color: #6366F1;
    color: #FFFFFF;
    font-weight: 700;
  }

  .form-footnote {
    font-size: 0.75rem;
    color: #64748B;
    text-align: center;
    margin-top: 0.5rem;
  }

  /* Success State */
  .modal-success-box {
    text-align: center;
    padding: 2.5rem 1rem;
  }

  .success-icon-wrap {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
  }

  .success-title {
    font-size: 1.75rem;
    color: #FFFFFF;
    margin-bottom: 0.5rem;
  }

  .success-desc {
    font-size: 0.95rem;
    color: #94A3B8;
    line-height: 1.6;
    max-width: 460px;
    margin: 0 auto 1.5rem;
  }

  .success-meta-card {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 1.25rem;
    background: #0B0E17;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    color: #CBD5E1;
  }

  @media (max-width: 600px) {
    .form-row-2 {
      grid-template-columns: 1fr;
    }
    .volume-selector-pills {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script>
  function setupDemoModal() {
    const modal = document.getElementById('demo-modal');
    const closeBtn = document.getElementById('modal-close-btn');
    const backdrop = document.getElementById('modal-backdrop-close');
    const form = document.getElementById('enterprise-demo-form') as HTMLFormElement | null;
    const successBox = document.getElementById('demo-success-state');
    const doneBtn = document.getElementById('modal-success-done-btn');

    function openModal() {
      if (modal) {
        modal.classList.add('active');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeModal() {
      if (modal) {
        modal.classList.remove('active');
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
    }

    // Attach to all elements with [data-open-demo]
    document.querySelectorAll('[data-open-demo]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      });
    });

    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);
    doneBtn?.addEventListener('click', () => {
      closeModal();
      // Reset view after close
      setTimeout(() => {
        if (form) form.style.display = 'flex';
        if (successBox) successBox.style.display = 'none';
      }, 300);
    });

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const submitBtn = document.getElementById('demo-submit-btn');
      if (submitBtn) {
        submitBtn.innerHTML = '<span>Verifying & Submitting...</span>';
      }

      setTimeout(() => {
        if (form) form.style.display = 'none';
        if (successBox) successBox.style.display = 'block';
        if (submitBtn) {
          submitBtn.innerHTML = '<span>Schedule Live Demo & Architecture Review</span>';
        }
      }, 600);
    });
  }

  // Run on page load
  setupDemoModal();
  document.addEventListener('astro:page-load', setupDemoModal);
</script>
