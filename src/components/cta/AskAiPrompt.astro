---
import { ASK_AI_PROVIDERS } from '../../data/ask-ai';
---

<section class="ask-ai-block" aria-labelledby="ask-ai-heading">
  <p id="ask-ai-heading" class="ask-ai-label">Ask AI about Shris</p>

  <div class="ask-ai-icons" role="list">
    {ASK_AI_PROVIDERS.map((provider) => (
      <a
        href={provider.href}
        class={`ask-ai-icon-btn ask-ai-icon-btn--${provider.id}`}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={provider.ariaLabel}
        role="listitem"
      >
        {provider.id === 'chatgpt' && (
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M22.282 9.821a5.985 5.985 0 0 0-.516-4.91 6.046 6.046 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.18a5.985 5.985 0 0 0-3.998 2.9 6.046 6.046 0 0 0 .742 7.097 5.98 5.98 0 0 0 .511 4.911 6.051 6.051 0 0 0 6.515 2.899A5.985 5.985 0 0 0 13.26 24a6.066 6.066 0 0 0 5.772-4.206 5.99 5.99 0 0 0 3.997-2.9 6.056 6.056 0 0 0-.747-7.073zM13.26 22.43a4.476 4.476 0 0 1-2.876-1.04l.141-.081 4.779-2.758a.795.795 0 0 0 .392-.681v-6.737l2.02 1.168a.071.071 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.494 4.494zM3.6 18.304a4.47 4.47 0 0 1-.535-3.014l.142.085 4.783 2.759a.771.771 0 0 0 .78 0l5.843-3.369v2.332a.08.08 0 0 1-.033.062L9.74 19.95a4.5 4.5 0 0 1-6.14-1.646zM2.34 7.896a4.485 4.485 0 0 1 2.366-1.973V11.6a.766.766 0 0 0 .388.676l5.815 3.355-2.02 1.168a.076.076 0 0 1-.071 0l-4.83-2.786A4.504 4.504 0 0 1 2.34 7.872zm16.597 3.855l-5.833-3.387L15.119 7.2a.076.076 0 0 1 .071 0l4.83 2.791a4.494 4.494 0 0 1-.676 8.105v-5.678a.79.79 0 0 0-.407-.667zm2.01-3.023l-.141-.085-4.774-2.758a.775.775 0 0 0-.785 0L9.409 9.23V6.897a.066.066 0 0 1 .028-.061l4.83-2.787a4.5 4.5 0 0 1 6.68 4.66zm-12.64 4.135l-2.02-1.164a.08.08 0 0 1-.038-.057V6.075a4.5 4.5 0 0 1 7.375-3.453l-.142.08-4.778 2.758a.795.795 0 0 0-.393.681zm1.097-2.365l2.602-1.5 2.607 1.5v2.999l-2.597 1.5-2.607-1.5z" />
          </svg>
        )}
        {provider.id === 'perplexity' && (
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15.5v-5.8L6.4 17.1A8.04 8.04 0 0 1 4 12c0-1.2.26-2.34.73-3.37l4.27 2.47V12l-5.5-3.18A7.96 7.96 0 0 1 12 4c2.05 0 3.92.78 5.33 2.06L12 9.24V6.5l6.8 3.93A8 8 0 0 1 11 17.5z" />
          </svg>
        )}
        {provider.id === 'claude' && (
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.5l1.8 4.9 4.9 1.8-4.9 1.8L12 15.9l-1.8-4.9-4.9-1.8 4.9-1.8L12 2.5zm0 6.2l.9 2.5 2.5.9-2.5.9-.9 2.5-.9-2.5-2.5-.9 2.5-.9.9-2.5zM5.5 16.5l1.2 3.3 3.3 1.2-3.3 1.2-1.2 3.3-1.2-3.3-3.3-1.2 3.3-1.2 1.2-3.3zm13 0 1.2 3.3 3.3 1.2-3.3 1.2-1.2 3.3-1.2-3.3-3.3-1.2 3.3-1.2 1.2-3.3z" />
          </svg>
        )}
        {provider.id === 'gemini' && (
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.2c.6 3.4 2.8 5.6 6.2 6.2-3.4.6-5.6 2.8-6.2 6.2-.6-3.4-2.8-5.6-6.2-6.2 3.4-.6 5.6-2.8 6.2-6.2z" />
          </svg>
        )}
      </a>
    ))}
  </div>

  <p class="ask-ai-note">
    Opens your assistant with the question already typed.<br />
    Answers come from the assistant, not from us.
  </p>
</section>

<style>
  .ask-ai-block {
    margin-top: 1.25rem;
    padding: 1.35rem 1.25rem 1.15rem;
    background: linear-gradient(180deg, var(--shris-navy-900) 0%, var(--shris-navy-950) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
  }

  .ask-ai-label {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #C9A227;
  }

  .ask-ai-icons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-bottom: 1rem;
  }

  .ask-ai-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.04);
    color: #E2E8F0;
    transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.2s ease, color 0.2s ease;
  }

  .ask-ai-icon-btn:hover {
    border-color: rgba(201, 162, 39, 0.45);
    background: rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
    transform: translateY(-1px);
  }

  .ask-ai-icon-btn:focus-visible {
    outline: 2px solid var(--shris-indigo-light);
    outline-offset: 2px;
  }

  .ask-ai-icon-btn--chatgpt:hover { color: #10A37F; }
  .ask-ai-icon-btn--perplexity:hover { color: #20B8CD; }
  .ask-ai-icon-btn--claude:hover { color: #D97757; }
  .ask-ai-icon-btn--gemini:hover { color: #4285F4; }

  .ask-ai-note {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.55;
    color: #64748B;
  }
</style>
