---
import { ASK_AI_PROVIDERS } from '../../data/ask-ai';
---

<section class="ask-ai" aria-labelledby="ask-ai-heading">
  <p id="ask-ai-heading" class="ask-ai__label">Ask AI about Shris</p>

  <ul class="ask-ai__providers">
    {ASK_AI_PROVIDERS.map((provider) => (
      <li>
        <a
          href={provider.href}
          class="ask-ai__provider"
          style={`--brand: ${provider.brandColor}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={provider.ariaLabel}
          title={provider.name}
        >
          <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d={provider.iconPath} />
          </svg>
        </a>
      </li>
    ))}
  </ul>

  <p class="ask-ai__note">
    Opens your assistant with the question already typed.<br />
    Answers come from the assistant, not from us.
  </p>
</section>

<style>
  .ask-ai {
    margin-top: 0.25rem;
    padding-top: 1.15rem;
    border-top: 1px solid var(--shris-border);
  }

  .ask-ai__label {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1;
    text-transform: uppercase;
    color: #9A7B1A;
  }

  .ask-ai__providers {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.8rem;
    padding: 0;
    list-style: none;
  }

  .ask-ai__provider {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 2.65rem;
    height: 2.65rem;
    border-radius: 0.65rem;
    border: 1px solid var(--shris-border);
    background: var(--shris-surface);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: var(--brand);
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .ask-ai__provider svg {
    width: 1.15rem;
    height: 1.15rem;
    display: block;
  }

  .ask-ai__provider:hover {
    border-color: color-mix(in srgb, var(--brand) 40%, white);
    background: color-mix(in srgb, var(--brand) 8%, white);
    box-shadow: 0 4px 14px color-mix(in srgb, var(--brand) 14%, transparent);
    transform: translateY(-1px);
  }

  .ask-ai__provider:focus-visible {
    outline: 2px solid var(--shris-indigo-light);
    outline-offset: 2px;
  }

  .ask-ai__note {
    margin: 0;
    max-width: 16.5rem;
    font-size: 0.74rem;
    line-height: 1.55;
    color: var(--shris-tx-tertiary);
  }
</style>
