---
---

<section class="section-wrapper final-cta-section" id="cta">
  <div class="ambient-glow-orb ambient-glow-gold" style="top: 20%; left: 50%; transform: translateX(-50%); width: 800px; height: 400px; opacity: 0.25;"></div>

  <div class="container">
    <div class="final-cta-card card-glass reveal-fade-up">
      <div class="cta-inner-content">
        <span class="eyebrow eyebrow-emerald">GET STARTED TODAY</span>
        <h2 class="cta-headline">
          Give your business a voice that <span class="gradient-text-gold">never sleeps</span>.
        </h2>
        <p class="cta-subcopy lead">
          Deploy intelligent voice agents that talk to customers, understand complex intent, and turn phone conversations into executed business actions — at scale.
        </p>

        <div class="cta-buttons-row">
          <a href="#agent-builder" class="btn btn-lg btn-primary btn-magnetic">
            <span>Build with Shris AI</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>

          <a href="#pricing" class="btn btn-lg btn-glass">
            <span>Book an Enterprise Consultation</span>
          </a>
        </div>

        <div class="cta-trust-checks">
          <span>✓ Sub-300ms Conversational Latency</span>
          <span>✓ 10+ Indian & Global Languages</span>
          <span>✓ Zero Data Retention (ZDR) Privacy</span>
          <span>✓ Native CRM & Calendar Integrations</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta-section {
    position: relative;
    padding: clamp(4rem, 8vw, 7rem) 0;
    text-align: center;
  }

  .final-cta-card {
    background: rgba(14, 18, 28, 0.9);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-2xl);
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1.5rem, 4vw, 3.5rem);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.8), 0 0 40px rgba(230, 168, 56, 0.12);
  }

  .cta-inner-content {
    max-width: 820px;
    margin: 0 auto;
  }

  .cta-headline {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    margin-bottom: 1.25rem;
    line-height: 1.15;
  }

  .cta-subcopy {
    margin-bottom: 2.5rem;
  }

  .cta-buttons-row {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .cta-trust-checks {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.25rem;
    font-size: 0.82rem;
    color: var(--text-secondary);
    font-family: var(--font-mono);
  }

  .cta-trust-checks span {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
</style>
