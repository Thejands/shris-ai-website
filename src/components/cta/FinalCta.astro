---
---

<section class="section-wrapper final-cta-section" id="cta">
  <div class="container">
    <div class="final-cta-card card-dark reveal-fade-up">
      <div class="cta-inner-content">
        <div class="eyebrow-container">
          <div class="eyebrow-line"></div>
          <p class="eyebrow-text">Deploy Sovereign Workforce</p>
          <div class="eyebrow-line"></div>
        </div>
        <h2 class="cta-headline">
          Give your business a voice that never sleeps.
        </h2>
        <p class="cta-subcopy lead">
          Deploy intelligent voice agents that talk to customers, understand complex intent, and turn phone conversations into executed business actions at scale.
        </p>

        <div class="cta-buttons-row">
          <button data-open-demo class="btn btn-indigo btn-lg">
            <span>Book an Architecture Demo</span>
          </button>
          <a href="/contact" class="btn btn-outline btn-lg" style="color: #FFFFFF; background: rgba(255,255,255,0.08);">
            <span>Contact Sales</span>
          </a>
        </div>

        <div class="cta-trust-checks">
          <span>✓ Sub-300ms Conversational Latency</span>
          <span>✓ 10+ Indian & Global Languages</span>
          <span>✓ Zero Data Retention (ZDR) Privacy</span>
          <span>✓ Native CRM & Calendar Integrations</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta-section {
    position: relative;
    padding: clamp(3rem, 6vw, 5rem) 0;
    text-align: center;
  }

  .final-cta-card {
    padding: clamp(2.5rem, 5vw, 4.5rem) clamp(1.5rem, 4vw, 3rem);
  }

  .cta-inner-content {
    max-width: 820px;
    margin: 0 auto;
  }

  .cta-headline {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    color: #FFFFFF;
    margin-bottom: 1.25rem;
    line-height: 1.15;
  }

  .cta-subcopy {
    color: #94A3B8;
    margin-bottom: 2.5rem;
  }

  .cta-buttons-row {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .cta-trust-checks {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    font-size: 0.82rem;
    color: #94A3B8;
    font-family: var(--font-mono);
  }
</style>
