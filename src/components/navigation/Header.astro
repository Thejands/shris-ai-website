---
const currentPath = Astro.url.pathname;
---

<header class="sarvam-header-fixed">
  <div class="header-outer-wrapper">
    <div class="header-capsule">
      <nav class="header-nav-row" aria-label="Main Navigation">
        <!-- Brand Logo Vector -->
        <a href="/" class="brand-wordmark" aria-label="Shris AI Home">
          <svg class="brand-motif-icon" width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="28" height="28" rx="8" fill="#1E2033"/>
            <path d="M7 14C7 10.134 10.134 7 14 7C17.866 7 21 10.134 21 14C21 17.866 17.866 21 14 21" stroke="#A5BBFC" stroke-width="2.5" stroke-linecap="round"/>
            <circle cx="14" cy="14" r="3" fill="#E6A838"/>
          </svg>
          <span class="brand-text">SHRIS <span class="brand-ai">AI</span></span>
        </a>

        <!-- Desktop Links -->
        <div class="nav-links-center">
          <a href="/platform" class={`nav-item-btn ${currentPath.startsWith('/platform') ? 'active' : ''}`}>Platform</a>
          <a href="/solutions" class={`nav-item-btn ${currentPath.startsWith('/solutions') ? 'active' : ''}`}>Solutions</a>
          <a href="/developers" class={`nav-item-btn ${currentPath.startsWith('/developers') ? 'active' : ''}`}>Developers</a>
          <a href="/pricing" class={`nav-item-btn ${currentPath.startsWith('/pricing') ? 'active' : ''}`}>Pricing</a>
          <a href="/company" class={`nav-item-btn ${currentPath.startsWith('/company') ? 'active' : ''}`}>Company</a>
        </div>

        <!-- Action CTAs -->
        <div class="nav-actions-right">
          <a href="/platform#demo" class="btn btn-sm btn-filled">
            <span>Sign up</span>
          </a>
          <a href="/pricing" class="btn btn-sm btn-outline">
            <span>Contact Us</span>
          </a>

          <!-- Mobile Hamburger -->
          <button class="mobile-toggle" id="mobile-menu-toggle" aria-label="Toggle navigation" aria-expanded="false">
            <span></span>
            <span></span>
          </button>
        </div>
      </nav>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div class="mobile-menu-drawer" id="mobile-drawer">
    <nav class="mobile-nav-list">
      <a href="/platform" class="mobile-link">Platform & Voice Intelligence</a>
      <a href="/solutions" class="mobile-link">Industry Solutions</a>
      <a href="/developers" class="mobile-link">Developers & APIs</a>
      <a href="/pricing" class="mobile-link">Pricing & Calculator</a>
      <div class="mobile-actions-box">
        <a href="/platform#demo" class="btn btn-filled" style="width: 100%;">Sign up</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .sarvam-header-fixed {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    pointer-events: none;
  }

  .header-outer-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0.75rem 1rem 0;
  }

  .header-capsule {
    pointer-events: auto;
    background-color: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(220, 220, 220, 0.5);
    backdrop-filter: blur(24px) saturate(1.3) brightness(1.04);
    -webkit-backdrop-filter: blur(24px) saturate(1.3) brightness(1.04);
    border-radius: var(--radius-capsule);
    box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.04), 0 2px 24px rgba(0, 0, 0, 0.02);
    padding: 0.5rem 1.25rem 0.5rem 1.75rem;
    transition: all 0.3s ease;
  }

  .header-nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand-wordmark {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }

  .brand-text {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #1E2033;
  }

  .brand-ai {
    color: #6A88E2;
  }

  .nav-links-center {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .nav-item-btn {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #1E2033;
    padding: 0.45rem 1rem;
    border-radius: var(--radius-full);
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .nav-item-btn:hover {
    background-color: rgba(30, 32, 51, 0.06);
    color: #0B0F19;
  }

  .nav-item-btn.active {
    background-color: #1E2033;
    color: #FFFFFF;
  }

  .nav-actions-right {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 32px;
    height: 32px;
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .mobile-toggle span {
    display: block;
    width: 18px;
    height: 1.5px;
    background: #1E2033;
    border-radius: 2px;
  }

  .mobile-menu-drawer {
    display: none;
    pointer-events: auto;
    margin: 0.5rem 1rem;
    background: #FFFFFF;
    border: 1px solid var(--sf-border-subtle);
    border-radius: var(--radius-xl);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.08);
    padding: 1.5rem;
  }

  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mobile-link {
    font-size: 1rem;
    font-weight: 600;
    color: var(--sf-slate-900);
  }

  .mobile-actions-box {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sf-border-subtle);
  }

  @media (max-width: 992px) {
    .nav-links-center {
      display: none;
    }
    .mobile-toggle {
      display: flex;
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-drawer');

  toggleBtn?.addEventListener('click', () => {
    const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
    toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
    if (drawer) {
      drawer.style.display = !isExpanded ? 'block' : 'none';
    }
  });
</script>
