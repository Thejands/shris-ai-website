---
import BrandWordmark from '../brand/BrandWordmark.astro';

const currentPath = Astro.url.pathname;
---

<header class="shris-header-fixed">
  <div class="header-outer-wrapper">
    <div class="header-capsule">
      <nav class="header-nav-row" aria-label="Main Navigation">
        <!-- Brand Logo Vector -->
        <BrandWordmark variant="header" href="/" />

        <!-- Desktop Links -->
        <div class="nav-links-center">
          <a href="/platform" class={`nav-item-btn ${currentPath.startsWith('/platform') ? 'active' : ''}`}>Platform</a>
          <a href="/solutions" class={`nav-item-btn ${currentPath.startsWith('/solutions') ? 'active' : ''}`}>Solutions</a>
          <a href="/developers" class={`nav-item-btn ${currentPath.startsWith('/developers') ? 'active' : ''}`}>Developers</a>
          <a href="/pricing" class={`nav-item-btn ${currentPath.startsWith('/pricing') ? 'active' : ''}`}>Pricing</a>
          <a href="/company" class={`nav-item-btn ${currentPath.startsWith('/company') ? 'active' : ''}`}>Company</a>
        </div>

        <!-- Action CTAs -->
        <div class="nav-actions-right">
          <button data-open-demo class="btn btn-sm btn-filled">
            <span>Book a Demo</span>
          </button>
          <a href="/contact" class="btn btn-sm btn-outline">
            <span>Contact Us</span>
          </a>

          <!-- Mobile Hamburger -->
          <button class="mobile-toggle" id="mobile-menu-toggle" aria-label="Toggle navigation" aria-expanded="false">
            <span></span>
            <span></span>
          </button>
        </div>
      </nav>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div class="mobile-menu-drawer" id="mobile-drawer">
    <nav class="mobile-nav-list">
      <a href="/platform" class="mobile-link">Platform & Speech Stack</a>
      <a href="/solutions" class="mobile-link">Industry Solutions</a>
      <a href="/docs/overview" class="mobile-link">Docs & Runtime</a>
      <a href="/developers" class="mobile-link">Developers & APIs</a>
      <a href="/pricing" class="mobile-link">Pricing & Calculator</a>
      <a href="/company" class="mobile-link">Company & Research</a>
      <a href="/app" class="mobile-link">Operations Console</a>
      <a href="/contact" class="mobile-link">Contact Sales</a>
      <div class="mobile-actions-box">
        <button data-open-demo class="btn btn-indigo" style="width: 100%;">Book a Demo</button>
      </div>
    </nav>
  </div>
</header>

<style>
  .shris-header-fixed {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    pointer-events: none;
  }

  .header-outer-wrapper {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0.85rem 1rem 0;
  }

  .header-capsule {
    pointer-events: auto;
    background-color: rgba(255, 255, 255, 0.85);
    border: 1px solid rgba(226, 232, 240, 0.85);
    backdrop-filter: blur(20px) saturate(1.2);
    -webkit-backdrop-filter: blur(20px) saturate(1.2);
    border-radius: var(--radius-capsule);
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.05);
    padding: 0.5rem 1rem 0.5rem 1.5rem;
    transition: all 0.3s ease;
  }

  .header-nav-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .nav-links-center {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-item-btn {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--shris-tx-secondary);
    padding: 0.45rem 0.95rem;
    border-radius: var(--radius-full);
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .nav-item-btn:hover {
    background-color: var(--shris-surface-subtle);
    color: var(--shris-tx-primary);
  }

  .nav-item-btn.active {
    background-color: var(--shris-navy-900);
    color: #FFFFFF;
  }

  .nav-actions-right {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 32px;
    height: 32px;
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .mobile-toggle span {
    display: block;
    width: 18px;
    height: 1.5px;
    background: var(--shris-navy-950);
    border-radius: 2px;
  }

  .mobile-menu-drawer {
    display: none;
    pointer-events: auto;
    margin: 0.5rem 1rem;
    background: #FFFFFF;
    border: 1px solid var(--shris-border);
    border-radius: var(--radius-xl);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.1);
    padding: 1.5rem;
  }

  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mobile-link {
    font-size: 1rem;
    font-weight: 600;
    color: var(--shris-tx-primary);
  }

  .mobile-actions-box {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--shris-border);
  }

  @media (max-width: 992px) {
    .nav-links-center {
      display: none;
    }
    .mobile-toggle {
      display: flex;
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-drawer');

  toggleBtn?.addEventListener('click', () => {
    const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
    toggleBtn.setAttribute('aria-expanded', String(!isExpanded));
    if (drawer) {
      drawer.style.display = !isExpanded ? 'block' : 'none';
    }
  });

  drawer?.querySelectorAll('a, button[data-open-demo]').forEach((item) => {
    item.addEventListener('click', () => {
      if (drawer) drawer.style.display = 'none';
      toggleBtn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
