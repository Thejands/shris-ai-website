---
---

<footer class="sarvam-footer">
  <div class="container">
    <!-- CTA Banner (Dark Card) -->
    <div class="footer-cta-card card-dark reveal-fade-up">
      <div class="cta-inner-content">
        <div class="eyebrow-container">
          <div class="eyebrow-line"></div>
          <p class="eyebrow-text" style="color: #A5BBFC;">Get Started Today</p>
          <div class="eyebrow-line"></div>
        </div>

        <h2 class="cta-title">Deploy your sovereign voice workforce.</h2>
        <p class="cta-desc">
          Test Shris AI live on your phone right now, or schedule an enterprise architecture session.
        </p>

        <div class="cta-buttons-row">
          <a href="/platform" class="btn btn-filled btn-lg">
            <span>Get Started Free</span>
          </a>
          <a href="/contact" class="btn btn-outline btn-lg" style="color: #FFFFFF; background: rgba(255,255,255,0.08);">
            <span>Contact Us</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Main Footer Links Grid -->
    <div class="footer-links-grid">
      <!-- Brand Col -->
      <div class="footer-brand-col">
        <div class="brand-wordmark">
          <svg class="brand-motif-icon" width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="28" height="28" rx="8" fill="#1E2033"/>
            <path d="M7 14C7 10.134 10.134 7 14 7C17.866 7 21 10.134 21 14C21 17.866 17.866 21 14 21" stroke="#A5BBFC" stroke-width="2.5" stroke-linecap="round"/>
            <circle cx="14" cy="14" r="3" fill="#E6A838"/>
          </svg>
          <span class="brand-text">SHRIS <span class="brand-ai">AI</span></span>
        </div>
        <p class="brand-desc">
          India's sovereign horizontal AI voice calling platform. Conversational agents that talk, understand intent, and execute business actions.
        </p>
        <span class="badge badge-emerald">Operational • 99.95% Telephony SLA</span>
      </div>

      <!-- Links 1: Platform -->
      <div class="footer-nav-col">
        <h4>Platform</h4>
        <ul>
          <li><a href="/platform">Voice Intelligence</a></li>
          <li><a href="/platform#multilingual">Multilingual Engine</a></li>
          <li><a href="/solutions">Industry Solutions</a></li>
          <li><a href="/solutions#integrations">Ecosystem Integrations</a></li>
          <li><a href="/platform#security">Enterprise Security</a></li>
        </ul>
      </div>

      <!-- Links 2: Developers & Resources -->
      <div class="footer-nav-col">
        <h4>Developers</h4>
        <ul>
          <li><a href="/developers">REST & WebSocket APIs</a></li>
          <li><a href="/developers#sdk">Python & Node SDK</a></li>
          <li><a href="/resources">Research & Benchmarks</a></li>
          <li><a href="/resources#whitepapers">Telephony Whitepapers</a></li>
          <li><a href="https://docs.sarvam.ai" target="_blank" rel="noreferrer">Sarvam Docs</a></li>
        </ul>
      </div>

      <!-- Links 3: Company -->
      <div class="footer-nav-col">
        <h4>Company</h4>
        <ul>
          <li><a href="/company">About & Sovereign Compute</a></li>
          <li><a href="/company#careers">Careers & Research</a></li>
          <li><a href="/pricing">Pricing & ROI Calculator</a></li>
          <li><a href="/pricing#faq">Frequently Asked Questions</a></li>
          <li><a href="/contact">Contact Sales</a></li>
        </ul>
      </div>
    </div>

    <!-- Copyright -->
    <div class="footer-bottom-row">
      <p>© 2026 Thejands LLP. All rights reserved. Sovereign Voice Compute.</p>
      <div class="footer-legal-links">
        <a href="/company">Privacy Policy</a>
        <a href="/company">Terms of Service</a>
        <a href="/platform#security">Security Statement</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .sarvam-footer {
    padding: 4rem 0 3rem;
    background: #FFFFFF;
    border-top: 1px solid rgba(30, 32, 51, 0.08);
  }

  .footer-cta-card {
    padding: clamp(2.5rem, 5vw, 4rem);
    text-align: center;
    margin-bottom: 4.5rem;
    background: #1E2033;
  }

  .cta-inner-content {
    max-width: 720px;
    margin: 0 auto;
  }

  .cta-title {
    font-size: clamp(2rem, 3.8vw, 3rem);
    color: #FFFFFF;
    margin-bottom: 1rem;
  }

  .cta-desc {
    font-size: 1.05rem;
    color: #94A3B8;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .cta-buttons-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  /* Footer Links */
  .footer-links-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 2.5rem;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid var(--sf-border-subtle);
  }

  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .brand-wordmark {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .brand-text {
    font-family: var(--font-sans);
    font-size: 1.2rem;
    font-weight: 800;
    color: #1E2033;
  }

  .brand-ai {
    color: #6A88E2;
  }

  .brand-desc {
    font-size: 0.85rem;
    color: var(--sf-tx-secondary);
    line-height: 1.55;
    margin: 0;
  }

  .footer-nav-col h4 {
    font-size: 0.92rem;
    color: #1E2033;
    margin-bottom: 1rem;
    font-weight: 700;
  }

  .footer-nav-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.85rem;
  }

  .footer-nav-col a {
    color: var(--sf-tx-secondary);
    transition: color 0.2s ease;
  }

  .footer-nav-col a:hover {
    color: #1E2033;
  }

  .footer-bottom-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.82rem;
    color: var(--sf-tx-tertiary);
  }

  .footer-legal-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  @media (max-width: 960px) {
    .footer-links-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 540px) {
    .footer-links-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
