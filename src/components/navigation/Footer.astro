---
import AskAiPrompt from '../cta/AskAiPrompt.astro';
import BrandWordmark from '../brand/BrandWordmark.astro';
---

<footer class="shris-footer">
  <div class="container">
    <!-- CTA Banner (Dark Card) -->
    <div class="footer-cta-card card-dark reveal-fade-up">
      <div class="cta-inner-content">
        <div class="eyebrow-container">
          <div class="eyebrow-line"></div>
          <p class="eyebrow-text" style="color: #A5BBFC;">Get Started Today</p>
          <div class="eyebrow-line"></div>
        </div>

        <h2 class="cta-title">Deploy your sovereign voice workforce.</h2>
        <p class="cta-desc">
          Test Shris AI live on your phone right now, or schedule an enterprise architecture session.
        </p>

        <div class="cta-buttons-row">
          <button data-open-demo class="btn btn-indigo btn-lg">
            <span>Book an Architecture Demo</span>
          </button>
          <a href="/contact" class="btn btn-outline btn-lg" style="color: #FFFFFF; background: rgba(255,255,255,0.08);">
            <span>Contact Sales</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Main Footer Links Grid -->
    <div class="footer-links-grid">
      <!-- Brand Col -->
      <div class="footer-brand-col">
        <BrandWordmark variant="footer" href="/" />
        <p class="brand-desc">
          Sovereign enterprise conversational AI voice platform engineered by Thejands. Autonomous agents that talk, understand intent, and execute business actions.
        </p>
        <span class="badge badge-emerald">Operational • 99.95% Telephony SLA</span>
        <AskAiPrompt />
      </div>

      <!-- Links 1: Platform -->
      <div class="footer-nav-col">
        <p class="footer-nav-heading">Platform</p>
        <ul>
          <li><a href="/platform">Voice Intelligence</a></li>
          <li><a href="/platform#multilingual">Multilingual Engine</a></li>
          <li><a href="/solutions">Industry Solutions</a></li>
          <li><a href="/solutions#integrations">Ecosystem Integrations</a></li>
          <li><a href="/platform#security">Enterprise Security</a></li>
        </ul>
      </div>

      <!-- Links 2: Developers & Resources -->
      <div class="footer-nav-col">
        <p class="footer-nav-heading">Developers</p>
        <ul>
          <li><a href="/developers">REST & WebSocket APIs</a></li>
          <li><a href="/developers#sdk">Python & Node SDK</a></li>
          <li><a href="/docs/overview">Platform Documentation</a></li>
          <li><a href="/resources">Research & Benchmarks</a></li>
          <li><a href="/resources#whitepapers">Telephony Whitepapers</a></li>
        </ul>
      </div>

      <!-- Links 3: Company -->
      <div class="footer-nav-col">
        <p class="footer-nav-heading">Company</p>
        <ul>
          <li><a href="/company">About & Sovereign Compute</a></li>
          <li><a href="/company#careers">Careers & Research</a></li>
          <li><a href="/pricing">Pricing & ROI Calculator</a></li>
          <li><a href="/pricing#faq">Frequently Asked Questions</a></li>
          <li><a href="/contact">Contact Sales</a></li>
        </ul>
      </div>
    </div>

    <!-- Copyright -->
    <div class="footer-bottom-row">
      <p>© 2026 <a class="parent-link" href="https://thejands.in/?utm_source=shris.thejands.in&amp;utm_medium=referral&amp;utm_campaign=product-footer" rel="noopener">Thejands</a>. All rights reserved. Sovereign Voice Compute.</p>
      <div class="footer-legal-links">
        <a href="/privacy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
        <a href="/security">Security Statement</a>
        <a href="/compliance">TRAI & DPDP</a>
        <a href="https://thejands.in/?utm_source=shris.thejands.in&amp;utm_medium=referral&amp;utm_campaign=product-footer" rel="noopener">Thejands <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>
</footer>

<style>
  .shris-footer {
    padding: 4rem 0 3rem;
    background: #FFFFFF;
    border-top: 1px solid rgba(15, 23, 42, 0.08);
  }

  .footer-cta-card {
    padding: clamp(2.5rem, 5vw, 4rem);
    text-align: center;
    margin-bottom: 4.5rem;
    background: var(--shris-navy-900);
  }

  .cta-inner-content {
    max-width: 720px;
    margin: 0 auto;
  }

  .cta-title {
    font-size: clamp(2rem, 3.8vw, 3rem);
    color: #FFFFFF;
    margin-bottom: 1rem;
  }

  .cta-desc {
    font-size: 1.05rem;
    color: #94A3B8;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .cta-buttons-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  /* Footer Links */
  .footer-links-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 2.5rem;
    padding-bottom: 3.5rem;
    border-bottom: 1px solid var(--shris-border);
  }

  .footer-brand-col {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .brand-desc {
    font-size: 0.85rem;
    color: var(--shris-tx-secondary);
    line-height: 1.55;
    margin: 0;
  }

  .footer-nav-col .footer-nav-heading {
    font-size: 0.92rem;
    color: var(--shris-navy-950);
    margin-bottom: 1rem;
    font-weight: 700;
  }

  .footer-nav-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.85rem;
  }

  .footer-nav-col a {
    color: var(--shris-tx-secondary);
    transition: color 0.2s ease;
  }

  .footer-nav-col a:hover {
    color: var(--shris-navy-950);
  }

  .parent-link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .footer-bottom-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.82rem;
    color: var(--shris-tx-tertiary);
  }

  .footer-legal-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }

  @media (max-width: 960px) {
    .footer-links-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 540px) {
    .footer-links-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
