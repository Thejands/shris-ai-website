---
const apiBase = import.meta.env.PUBLIC_VOICE_API_ENDPOINT ?? 'http://127.0.0.1:8787/v1';
---

<section class="ops-shell" id="main-content" data-api-base={apiBase}>
  <aside class="ops-sidebar">
    <div class="sidebar-brand">
      <span class="brand-mark" aria-hidden="true">((•))</span>
      <div>
        <p class="brand-name">Shris AI</p>
        <p class="brand-sub">AI Voice Workforce Platform</p>
      </div>
    </div>

    <div class="sidebar-tenant" id="sidebar-tenant" hidden>
      <span id="sidebar-tenant-name">—</span>
      <span class="tenant-role" id="sidebar-tenant-role"></span>
    </div>

    <nav class="sidebar-nav" aria-label="Console">
      <button type="button" class="nav-item active" data-panel="overview">Overview</button>

      <p class="nav-group">AI Workforce</p>
      <button type="button" class="nav-item" data-panel="agents">Agents</button>
      <button type="button" class="nav-item nav-soon" data-panel="soon" data-soon-title="Agent Templates" data-soon-body="No template concept yet — agents are configured individually per tenant.">Agent Templates</button>
      <button type="button" class="nav-item nav-soon" data-panel="soon" data-soon-title="Knowledge" data-soon-body="No document store or retrieval layer exists yet — agents run on hardcoded qualify scripts.">Knowledge</button>
      <button type="button" class="nav-item nav-soon" data-panel="soon" data-soon-title="Tools" data-soon-body="No function-calling / tool registry in the dialog engine yet.">Tools</button>

      <p class="nav-group">Communications</p>
      <button type="button" class="nav-item" data-panel="inbound">Inbound Calls</button>
      <button type="button" class="nav-item" data-panel="outbound">Outbound Calls</button>
      <button type="button" class="nav-item" data-panel="conversations">Conversations</button>
      <button type="button" class="nav-item" data-panel="numbers">Phone Numbers</button>

      <p class="nav-group">Automation</p>
      <button type="button" class="nav-item" data-panel="campaigns">Campaigns</button>
      <button type="button" class="nav-item nav-soon" data-panel="soon" data-soon-title="Workflows" data-soon-body="No visual workflow builder — the dialog state machine is fixed and coded, not tenant-authored.">Workflows</button>

      <p class="nav-group">Business</p>
      <button type="button" class="nav-item" data-panel="contacts">Contacts</button>
      <button type="button" class="nav-item" data-panel="integrations">Integrations</button>

      <p class="nav-group">Intelligence</p>
      <button type="button" class="nav-item" data-panel="analytics">Analytics</button>
      <button type="button" class="nav-item nav-soon" data-panel="soon" data-soon-title="Conversation Intelligence" data-soon-body="QA scoring exists (disclosure / opt-out checks). Sentiment, topic tagging, and coaching insights don't.">Conversation Intelligence</button>

      <p class="nav-group">Platform</p>
      <a class="nav-item" href="/developers">Developers</a>
      <button type="button" class="nav-item nav-soon" data-panel="soon" data-soon-title="Usage &amp; Billing" data-soon-body="No metering or pricing model exists yet — this is a new subsystem, not a UI gap.">Usage &amp; Billing</button>

      <p class="nav-group">Admin</p>
      <button type="button" class="nav-item" data-panel="team">Team</button>
      <button type="button" class="nav-item" data-panel="compliance">Security &amp; Compliance</button>
      <button type="button" class="nav-item nav-soon" data-panel="soon" data-soon-title="Settings" data-soon-body="No tenant-settings API beyond agent configuration exists yet.">Settings</button>
    </nav>
  </aside>

  <div class="ops-main">
    <header class="ops-topbar">
      <div>
        <p class="ops-topbar-eyebrow" id="topbar-eyebrow">Overview</p>
        <h1 id="topbar-title">Real-time performance across your AI voice operations</h1>
      </div>
      <div class="ops-top-actions">
        <span class="badge badge-emerald" id="trai-badge">TRAI window: —————</span>
        <span class="badge badge-indigo" id="api-badge">API: —————————</span>
        <span class="badge badge-emerald" id="hipaa-badge" hidden>HIPAA mode</span>
        <label class="demo-toggle">
          <input type="checkbox" id="demo-toggle" />
          <span class="demo-toggle-track" aria-hidden="true"></span>
          <span class="demo-toggle-label">Demo data</span>
        </label>
        <button type="button" class="btn btn-sm btn-outline" id="logout-btn" hidden>Sign out</button>
      </div>
    </header>

    <p class="demo-banner" id="demo-banner" hidden>
      Showing sample data — this tenant's real numbers are hidden while Demo data is on.
    </p>

    <div id="login-panel" class="card-light login-panel">
      <h2>Tenant sign-in</h2>
      <p class="muted">JWT is tenant-scoped. Local admin <code>dev@shris.ai</code> · operator <code>operator@shris.ai</code> · viewer <code>viewer@shris.ai</code>. Second tenant: <code>acme@shris.ai</code>. Viewers cannot dispatch. Only admins manage users.</p>
      <form id="login-form">
        <label for="login-email">Work email</label>
        <input id="login-email" name="email" type="email" required autocomplete="username" value="dev@shris.ai" />
        <label for="login-password">Password</label>
        <input id="login-password" name="password" type="password" required autocomplete="current-password" value="shris-dev-local" />
        <button type="submit" class="btn btn-indigo" style="margin-top:1rem;">Issue JWT</button>
      </form>
      <p id="login-error" class="login-error" role="alert"></p>
    </div>

    <div id="ops-authenticated" hidden>

      <!-- ============ OVERVIEW ============ -->
      <div class="panel" data-panel="overview">
        <div class="kpi-grid">
          <article class="kpi-card" data-kpi="total-calls">
            <div class="kpi-head"><span class="kpi-icon kpi-icon-blue">☎</span><span class="kpi-label">Total Calls</span></div>
            <strong class="kpi-value" id="kpi2-total-calls">—</strong>
            <span class="kpi-sub" id="kpi2-total-calls-sub"></span>
          </article>
          <article class="kpi-card" data-kpi="connected-calls">
            <div class="kpi-head"><span class="kpi-icon kpi-icon-green">✓</span><span class="kpi-label">Connected Calls</span></div>
            <strong class="kpi-value" id="kpi2-connected-calls">—</strong>
            <span class="kpi-sub" id="kpi2-connected-calls-sub"></span>
          </article>
          <article class="kpi-card" data-kpi="conversations">
            <div class="kpi-head"><span class="kpi-icon kpi-icon-violet">◈</span><span class="kpi-label">Conversations</span></div>
            <strong class="kpi-value" id="kpi2-conversations">—</strong>
            <span class="kpi-sub" id="kpi2-conversations-sub"></span>
          </article>
          <article class="kpi-card" data-kpi="avg-duration">
            <div class="kpi-head"><span class="kpi-icon kpi-icon-amber">◷</span><span class="kpi-label">Avg. Call Duration</span></div>
            <strong class="kpi-value" id="kpi2-avg-duration">—</strong>
            <span class="kpi-sub" id="kpi2-avg-duration-sub">Sign in to load.</span>
          </article>
          <article class="kpi-card" data-kpi="success-rate">
            <div class="kpi-head"><span class="kpi-icon kpi-icon-teal">◎</span><span class="kpi-label">Success Rate</span></div>
            <strong class="kpi-value" id="kpi2-success-rate">—</strong>
            <span class="kpi-sub" id="kpi2-success-rate-sub">Connected ÷ (connected + blocked)</span>
          </article>
          <article class="kpi-card" data-kpi="cost">
            <div class="kpi-head"><span class="kpi-icon kpi-icon-rose">₹</span><span class="kpi-label">Cost This Month</span></div>
            <strong class="kpi-value" id="kpi2-cost">—</strong>
            <span class="kpi-sub" id="kpi2-cost-sub">Not tracked yet — no metering/billing subsystem.</span>
          </article>
        </div>

        <div class="stat-strip">
          <article class="stat-cell">
            <span class="stat-icon">📣</span>
            <div><strong id="stat-campaigns">—</strong><span>Active Campaigns</span></div>
          </article>
          <article class="stat-cell">
            <span class="stat-icon">🤖</span>
            <div><strong id="stat-agents">—</strong><span>Active Agents</span></div>
          </article>
          <article class="stat-cell">
            <span class="stat-icon">👥</span>
            <div><strong id="stat-contacts">—</strong><span>Total Contacts</span></div>
          </article>
          <article class="stat-cell">
            <span class="stat-icon">⛔</span>
            <div><strong id="stat-dnc">—</strong><span>DNC Numbers</span></div>
          </article>
          <article class="stat-cell">
            <span class="stat-icon">🛡</span>
            <div><strong id="stat-compliance">—</strong><span>Compliance Score</span></div>
          </article>
        </div>

        <p class="overview-note">Charts (performance trend, call-outcome distribution, time-of-day heatmap) and the top-agents / recent-conversations tables aren't built yet — they need real aggregation work the backend doesn't do today. This first pass wires the number cards to real endpoints.</p>
      </div>

      <!-- ============ AGENTS ============ -->
      <div class="panel" data-panel="agents" hidden>
        <div class="card-light users-card" id="agents-card">
          <h2>Agent playbooks</h2>
          <p class="muted">Per-tenant disclosure, qualify script, and language. JWT-scoped — Acme cannot edit local agents.</p>
          <form id="agent-config-form" class="create-user-form">
            <label for="agent-select">Agent</label>
            <select id="agent-select" name="id"></select>
            <label for="agent-language">Language</label>
            <select id="agent-language" name="language">
              <option value="en-IN">English (India)</option>
              <option value="hi-IN">Hindi</option>
              <option value="ta-IN">Tamil</option>
              <option value="te-IN">Telugu</option>
            </select>
            <label for="agent-disclosure">AI disclosure</label>
            <input id="agent-disclosure" name="disclosure" type="text" required />
            <label for="agent-script">Qualify script</label>
            <input id="agent-script" name="qualifyScript" type="text" required />
            <button type="submit" class="btn btn-indigo">Save playbook</button>
          </form>
          <p id="agents-error" class="login-error" role="alert"></p>
        </div>
      </div>

      <!-- ============ INBOUND CALLS ============ -->
      <div class="panel" data-panel="inbound" hidden>
        <div class="card-light ops-table-card">
          <div class="ops-card-head">
            <h2>Inbound calls</h2>
          </div>
          <p class="muted">All persisted calls for this tenant — not yet split by inbound/outbound direction on the call record.</p>
          <div class="ops-table-wrap">
            <table>
              <caption class="sr-only">Persisted voice calls for this tenant</caption>
              <thead>
                <tr><th scope="col">Call</th><th scope="col">Agent</th><th scope="col">To</th><th scope="col">Status</th><th scope="col">Disclosure</th><th scope="col">QA</th></tr>
              </thead>
              <tbody id="fleet-body-inbound"><tr><td colspan="6" class="muted">Sign in to load persisted calls.</td></tr></tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ============ OUTBOUND CALLS ============ -->
      <div class="panel" data-panel="outbound" hidden>
        <div class="ops-side">
          <div class="card-dark dispatch-card" id="dispatch-card">
            <h2>Dispatch test (simulator)</h2>
            <p>JWT-authenticated. Live PSTN requires SIP/CPaaS env on Shris-ai-app. Every call records AI disclosure.</p>
            <form id="dispatch-form">
              <label for="dispatch-to">Destination E.164</label>
              <input id="dispatch-to" name="to" type="tel" required placeholder="+919876543210" value="+919876543210" />
              <label for="dispatch-agent">Playbook</label>
              <select id="dispatch-agent" name="agent_id">
                <option value="agent_re_falcon_city">Real Estate · Aarav</option>
                <option value="agent_hc_opd">Healthcare · Priya</option>
                <option value="agent_bfsi_kyc">BFSI · Vikram</option>
                <option value="agent_edu_admit">Education · Ananya</option>
                <option value="agent_retail_cod">Retail · Kavya</option>
                <option value="agent_travel_vip">Travel · Kabir</option>
              </select>
              <button type="submit" class="btn btn-indigo" style="width:100%;margin-top:1rem;">Run compliance + dispatch</button>
            </form>
            <pre id="dispatch-result" class="dispatch-result" aria-live="polite">Idle. API {apiBase}</pre>
          </div>
        </div>
        <div class="card-light ops-table-card" style="margin-top:1.25rem;">
          <div class="ops-card-head"><h2>Persisted fleet</h2><span class="pulse-dot"></span></div>
          <div class="ops-table-wrap">
            <table>
              <caption class="sr-only">Persisted voice calls for this tenant</caption>
              <thead>
                <tr><th scope="col">Call</th><th scope="col">Agent</th><th scope="col">To</th><th scope="col">Status</th><th scope="col">Disclosure</th><th scope="col">QA</th></tr>
              </thead>
              <tbody id="fleet-body"><tr><td colspan="6" class="muted">Sign in to load persisted calls.</td></tr></tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ============ CONVERSATIONS ============ -->
      <div class="panel" data-panel="conversations" hidden>
        <div class="ops-side">
          <div class="card-light" id="voice-loop-card">
            <h2>Voice loop (no PSTN)</h2>
            <p class="muted">POST /v1/conversations/:id/turns — Hinglish NLU, disclosure, CRM/calendar/WhatsApp on book.</p>
            <form id="voice-loop-form" class="create-user-form">
              <label for="voice-domain">Domain</label>
              <select id="voice-domain" name="domain">
                <option value="real_estate">Real estate</option>
                <option value="healthcare">Healthcare</option>
                <option value="bfsi">BFSI</option>
                <option value="education">Education</option>
                <option value="retail">Retail</option>
                <option value="travel">Travel</option>
              </select>
              <label for="voice-turn">Caller transcript</label>
              <input id="voice-turn" name="text" type="text" required placeholder="3 bhk 1.5 crore Whitefield, confirm" />
              <button type="submit" class="btn btn-indigo">Send turn</button>
            </form>
            <pre id="voice-loop-result" class="dispatch-result" aria-live="polite">Start a turn after sign-in (JWT optional on this route).</pre>
          </div>

          <div class="card-light funnel-card" id="handoff-card">
            <h2 id="handoff-heading">Warm handoff queue</h2>
            <p class="muted">Conversations in <code>handoff</code> state. Operators accept, reply as the specialist, then resolve.</p>
            <div id="handoff-list" class="handoff-list" aria-labelledby="handoff-heading">
              <p class="muted">No live handoffs. Ask for a human in the voice loop.</p>
            </div>
            <p id="handoff-error" class="login-error" role="alert"></p>
          </div>
        </div>
      </div>

      <!-- ============ PHONE NUMBERS ============ -->
      <div class="panel" data-panel="numbers" hidden>
        <div class="card-light" id="numbers-card">
          <h2>DID inventory</h2>
          <p class="muted">Simulator numbers. Operators can rotate; viewers list only. Live carrier DIDs stay in tenant env.</p>
          <div class="ops-table-wrap">
            <table>
              <caption class="sr-only">Inbound DID inventory</caption>
              <thead><tr><th scope="col">Label</th><th scope="col">E.164</th><th scope="col">Status</th><th scope="col">Rotate</th></tr></thead>
              <tbody id="numbers-body"><tr><td colspan="4" class="muted">Sign in to load inventory.</td></tr></tbody>
            </table>
          </div>
          <p id="numbers-error" class="login-error" role="alert"></p>
        </div>
      </div>

      <!-- ============ CAMPAIGNS ============ -->
      <div class="panel" data-panel="campaigns" hidden>
        <div class="card-light" id="campaigns-card">
          <h2>Campaigns</h2>
          <p class="muted" id="campaigns-hint">Operators and admins can create campaigns. Viewers can list only. Nothing dials from this list yet — batch execution is a separate, not-yet-built engine.</p>
          <form id="create-campaign-form" class="create-user-form">
            <label for="camp-name">Name</label>
            <input id="camp-name" name="name" type="text" required placeholder="Weekend site visits" />
            <label for="camp-domain">Domain</label>
            <input id="camp-domain" name="domain" type="text" placeholder="Real Estate" />
            <label for="camp-agent">Agent playbook</label>
            <select id="camp-agent" name="agent_id">
              <option value="agent_re_falcon_city">Real Estate · Aarav</option>
              <option value="agent_hc_opd">Healthcare · Priya</option>
              <option value="agent_bfsi_kyc">BFSI · Vikram</option>
              <option value="agent_edu_admit">Education · Ananya</option>
              <option value="agent_retail_cod">Retail · Kavya</option>
              <option value="agent_travel_vip">Travel · Kabir</option>
            </select>
            <button type="submit" class="btn btn-indigo">Create campaign</button>
          </form>
          <p id="campaign-error" class="login-error" role="alert"></p>
          <ul class="campaign-list" id="campaign-list"></ul>
        </div>
      </div>

      <!-- ============ CONTACTS ============ -->
      <div class="panel" data-panel="contacts" hidden>
        <div class="card-light ops-table-card">
          <div class="ops-card-head"><h2>Contacts</h2></div>
          <p class="muted">Leads ingested via POST /v1/leads. No separate CRM-style contact model yet — this is the raw lead list.</p>
          <div class="ops-table-wrap">
            <table>
              <caption class="sr-only">Tenant contacts</caption>
              <thead><tr><th scope="col">Name</th><th scope="col">Phone</th><th scope="col">Source</th><th scope="col">Domain</th><th scope="col">Created</th></tr></thead>
              <tbody id="contacts-body"><tr><td colspan="5" class="muted">Sign in to load contacts.</td></tr></tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ============ INTEGRATIONS ============ -->
      <div class="panel" data-panel="integrations" hidden>
        <div class="card-light users-card" id="integrations-card">
          <h2>Connect status</h2>
          <p class="muted">Admin only. Modes come from env presence. Secrets are never shown. <a href="/docs/connect-checklist">Connect checklist</a>.</p>
          <div class="ops-table-wrap">
            <table>
              <caption class="sr-only">Integration provider modes</caption>
              <thead><tr><th scope="col">Provider</th><th scope="col">Mode</th><th scope="col">Env to unlock live</th></tr></thead>
              <tbody id="integrations-body"><tr><td colspan="3" class="muted">Loading…</td></tr></tbody>
            </table>
          </div>
          <p id="integrations-note" class="muted"></p>
          <p id="integrations-error" class="login-error" role="alert"></p>
        </div>
      </div>

      <!-- ============ ANALYTICS ============ -->
      <div class="panel" data-panel="analytics" hidden>
        <div class="card-light funnel-card">
          <h2 id="funnel-heading">Pipeline funnel</h2>
          <p class="muted">Live counts from GET /v1/kpis. Bar length is each stage as a share of attempted.</p>
          <ol class="funnel-visual" id="funnel-list" aria-labelledby="funnel-heading">
            <li>
              <div class="funnel-meta"><span>Attempted</span><b id="funnel-d">0</b></div>
              <div class="funnel-track" role="img" aria-labelledby="funnel-d-label"><div class="funnel-fill" id="funnel-fill-d" data-stage="attempted"></div></div>
              <span class="sr-only" id="funnel-d-label">Attempted 0 of 0</span>
            </li>
            <li>
              <div class="funnel-meta"><span>Connected</span><b id="funnel-c">0</b></div>
              <div class="funnel-track" role="img" aria-labelledby="funnel-c-label"><div class="funnel-fill" id="funnel-fill-c" data-stage="connected"></div></div>
              <span class="sr-only" id="funnel-c-label">Connected 0 of 0</span>
            </li>
            <li>
              <div class="funnel-meta"><span>Qualified</span><b id="funnel-q">0</b></div>
              <div class="funnel-track" role="img" aria-labelledby="funnel-q-label"><div class="funnel-fill" id="funnel-fill-q" data-stage="qualified"></div></div>
              <span class="sr-only" id="funnel-q-label">Qualified 0 of 0</span>
            </li>
            <li>
              <div class="funnel-meta"><span>Booked</span><b id="funnel-b">0</b></div>
              <div class="funnel-track" role="img" aria-labelledby="funnel-b-label"><div class="funnel-fill" id="funnel-fill-b" data-stage="booked"></div></div>
              <span class="sr-only" id="funnel-b-label">Booked 0 of 0</span>
            </li>
          </ol>
          <h3 id="lang-heading">Language mix</h3>
          <ul class="lang-mix" aria-labelledby="lang-heading">
            <li><span>English (en-IN)</span><div class="funnel-track" role="img" aria-labelledby="lang-en-label"><div class="funnel-fill lang-en" id="lang-fill-en"></div></div><b id="lang-en">0</b><span class="sr-only" id="lang-en-label">English 0</span></li>
            <li><span>Hindi (hi-IN)</span><div class="funnel-track" role="img" aria-labelledby="lang-hi-label"><div class="funnel-fill lang-hi" id="lang-fill-hi"></div></div><b id="lang-hi">0</b><span class="sr-only" id="lang-hi-label">Hindi 0</span></li>
            <li><span>Tamil (ta-IN)</span><div class="funnel-track" role="img" aria-labelledby="lang-ta-label"><div class="funnel-fill lang-ta" id="lang-fill-ta"></div></div><b id="lang-ta">0</b><span class="sr-only" id="lang-ta-label">Tamil 0</span></li>
            <li><span>Telugu (te-IN)</span><div class="funnel-track" role="img" aria-labelledby="lang-te-label"><div class="funnel-fill lang-te" id="lang-fill-te"></div></div><b id="lang-te">0</b><span class="sr-only" id="lang-te-label">Telugu 0</span></li>
          </ul>
        </div>

        <div class="card-light funnel-card" id="qa-card">
          <div class="ops-card-head">
            <h2 id="qa-heading">Call QA scores</h2>
            <label class="qa-filter"><input type="checkbox" id="qa-low-only" /> Low scores only (&lt;80%)</label>
          </div>
          <p class="muted">From persisted call records (GET /v1/calls, optional qaMax). Disclosure and opt-out checks from the conversation QA scorer — not a live QA vendor.</p>
          <div class="ops-table-wrap">
            <table>
              <caption class="sr-only">Call QA scores for this tenant</caption>
              <thead><tr><th scope="col">Call</th><th scope="col">Score</th><th scope="col">Disclosure</th><th scope="col">Notes</th></tr></thead>
              <tbody id="qa-body"><tr><td colspan="4" class="muted">Sign in to load QA scores.</td></tr></tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- ============ TEAM ============ -->
      <div class="panel" data-panel="team" hidden>
        <div class="card-light users-card" id="users-card">
          <h2>Tenant users</h2>
          <p class="muted">Admin only. Creates users in the JWT tenant. Operators and viewers cannot open this panel.</p>
          <div class="ops-table-wrap">
            <table>
              <caption class="sr-only">Users in this tenant</caption>
              <thead><tr><th scope="col">Email</th><th scope="col">Name</th><th scope="col">Role</th></tr></thead>
              <tbody id="users-body"><tr><td colspan="3" class="muted">Loading…</td></tr></tbody>
            </table>
          </div>
          <form id="create-user-form" class="create-user-form">
            <label for="new-user-email">Email</label>
            <input id="new-user-email" name="email" type="email" required autocomplete="off" />
            <label for="new-user-name">Name</label>
            <input id="new-user-name" name="name" type="text" required />
            <label for="new-user-role">Role</label>
            <select id="new-user-role" name="role">
              <option value="viewer">viewer</option>
              <option value="operator">operator</option>
              <option value="admin">admin</option>
            </select>
            <label for="new-user-password">Temporary password</label>
            <input id="new-user-password" name="password" type="password" required minlength="10" autocomplete="new-password" />
            <button type="submit" class="btn btn-indigo">Create user</button>
          </form>
          <p id="users-error" class="login-error" role="alert"></p>
        </div>
      </div>

      <!-- ============ SECURITY & COMPLIANCE ============ -->
      <div class="panel" data-panel="compliance" hidden>
        <div class="card-light ops-table-card">
          <div class="ops-card-head"><h2>Audit log</h2></div>
          <p class="muted">Admin only. Immutable append-only log from GET /v1/audit.</p>
          <div class="ops-table-wrap">
            <table>
              <caption class="sr-only">Tenant audit log</caption>
              <thead><tr><th scope="col">When</th><th scope="col">Actor</th><th scope="col">Action</th><th scope="col">Detail</th></tr></thead>
              <tbody id="audit-body"><tr><td colspan="4" class="muted">Sign in as admin to load the audit log.</td></tr></tbody>
            </table>
          </div>
          <p id="audit-error" class="login-error" role="alert"></p>
        </div>
      </div>

      <!-- ============ SOON PLACEHOLDER ============ -->
      <div class="panel soon-panel" data-panel="soon" hidden>
        <div class="card-light soon-card">
          <h2 id="soon-title">Not built yet</h2>
          <p class="muted" id="soon-body"></p>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* ---- Dark console theme (scoped to this component only) ---- */
  .ops-shell {
    --console-bg: #0B0E14;
