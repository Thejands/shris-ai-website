  }
  .nav-item:hover { background: var(--console-surface-raised); color: var(--console-ink); }
  .nav-item.active { background: var(--console-accent); color: #fff; font-weight: 600; }
  .nav-item.nav-soon { color: var(--console-muted); }
  .nav-item.nav-soon:hover { color: var(--console-ink-soft); }

  /* ---- main ---- */
  .ops-main { padding: 1.75rem 2rem 3rem; min-width: 0; }

  .ops-topbar { display: flex; align-items: flex-start; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; margin-bottom: 0.5rem; }
  .ops-topbar-eyebrow { margin: 0 0 0.2rem; font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--console-accent-soft); }
  .ops-topbar h1 { margin: 0; font-size: 1.4rem; color: var(--console-ink); max-width: 46ch; }
  .ops-top-actions { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }

  .badge { font-family: var(--font-mono); font-size: 0.7rem; padding: 0.25rem 0.6rem; border-radius: 99px; border: 1px solid var(--console-border); }
  .badge-emerald { background: rgba(34,197,94,0.12); color: var(--console-green); border-color: rgba(34,197,94,0.3); }
  .badge-indigo { background: rgba(79,107,255,0.14); color: var(--console-accent-soft); border-color: rgba(79,107,255,0.3); }

  .demo-toggle { display: inline-flex; align-items: center; gap: 0.5rem; cursor: pointer; user-select: none; }
  .demo-toggle input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .demo-toggle-track {
    width: 34px; height: 19px; border-radius: 99px; background: var(--console-border);
    position: relative; transition: background 0.15s ease; flex-shrink: 0;
  }
  .demo-toggle-track::after {
    content: ""; position: absolute; top: 2px; left: 2px; width: 15px; height: 15px;
    border-radius: 50%; background: #fff; transition: transform 0.15s ease;
  }
  .demo-toggle input:checked + .demo-toggle-track { background: var(--console-amber); }
  .demo-toggle input:checked + .demo-toggle-track::after { transform: translateX(15px); }
  .demo-toggle input:focus-visible + .demo-toggle-track { outline: 2px solid var(--console-accent-soft); outline-offset: 2px; }
  .demo-toggle-label { font-size: 0.8rem; color: var(--console-ink-soft); }

  .demo-banner {
    margin: 0.75rem 0 1.25rem;
    padding: 0.55rem 0.9rem;
    background: rgba(245,158,11,0.12);
    border: 1px solid rgba(245,158,11,0.35);
    color: var(--console-amber);
    border-radius: 8px;
    font-size: 0.82rem;
  }

  /* ---- login (reuse global card-light but recolor within this component) ---- */
  .login-panel { background: var(--console-surface); border: 1px solid var(--console-border); border-radius: 10px; padding: 1.5rem; max-width: 480px; margin-top: 1rem; }
  .login-panel h2 { margin-top: 0; color: var(--console-ink); }
  .login-panel .muted { color: var(--console-ink-soft); font-size: 0.85rem; }
  .login-panel label { display: block; margin: 0.75rem 0 0.25rem; font-size: 0.8rem; color: var(--console-ink-soft); }
  .login-panel input { width: 100%; box-sizing: border-box; padding: 0.55rem 0.7rem; border-radius: 6px; border: 1px solid var(--console-border); background: var(--console-surface-raised); color: var(--console-ink); }
  .login-error { color: var(--console-red); font-size: 0.82rem; min-height: 1.2em; }

  /* ---- KPI overview ---- */
  .panel { min-width: 0; }
  .kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 0.9rem; margin-bottom: 1.1rem; }
  .kpi-card { background: var(--console-surface); border: 1px solid var(--console-border); border-radius: 12px; padding: 1rem 1.1rem; }
  .kpi-head { display: flex; align-items: center; gap: 0.55rem; margin-bottom: 0.7rem; }
  .kpi-icon { width: 30px; height: 30px; border-radius: 9px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.9rem; color: #fff; flex-shrink: 0; }
  .kpi-icon-blue { background: #3B5BFF; }
  .kpi-icon-green { background: #16A34A; }
  .kpi-icon-violet { background: #9333EA; }
  .kpi-icon-amber { background: #D97706; }
  .kpi-icon-teal { background: #0D9488; }
  .kpi-icon-rose { background: #E11D48; }
  .kpi-label { font-size: 0.78rem; color: var(--console-ink-soft); }
  .kpi-value { display: block; font-size: 1.55rem; font-weight: 700; color: var(--console-ink); font-variant-numeric: tabular-nums; }
  .kpi-sub { display: block; margin-top: 0.3rem; font-size: 0.72rem; color: var(--console-muted); line-height: 1.4; }

  .stat-strip { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 0.9rem; margin-bottom: 1.25rem; }
  .stat-cell { background: var(--console-surface); border: 1px solid var(--console-border); border-radius: 12px; padding: 0.9rem 1rem; display: flex; align-items: center; gap: 0.7rem; }
  .stat-icon { font-size: 1.15rem; }
  .stat-cell strong { display: block; font-size: 1.1rem; color: var(--console-ink); font-variant-numeric: tabular-nums; }
  .stat-cell span { font-size: 0.72rem; color: var(--console-muted); }

  .overview-note { font-size: 0.8rem; color: var(--console-muted); max-width: 68ch; border-top: 1px dashed var(--console-border); padding-top: 0.9rem; }

  /* ---- generic cards inside panels (recolor the shared card-light/card-dark classes) ---- */
  .card-light, .card-dark {
    background: var(--console-surface) !important;
    border: 1px solid var(--console-border) !important;
    border-radius: 12px !important;
    color: var(--console-ink) !important;
    padding: 1.25rem 1.4rem !important;
  }
  .card-light h2, .card-dark h2, .card-light h3, .card-dark h3 { color: var(--console-ink); margin-top: 0; }
  .card-light .muted, .card-dark p { color: var(--console-ink-soft); font-size: 0.85rem; }
  .ops-side { display: grid; gap: 1.1rem; }
  .ops-card-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .pulse-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--console-green); box-shadow: 0 0 0 4px rgba(34,197,94,0.18); }

  .ops-table-wrap { overflow-x: auto; margin-top: 0.75rem; }
  table { width: 100%; border-collapse: collapse; font-size: 0.83rem; }
  th { text-align: left; font-size: 0.68rem; letter-spacing: 0.05em; text-transform: uppercase; color: var(--console-muted); padding: 0.5rem 0.7rem; border-bottom: 1px solid var(--console-border); white-space: nowrap; }
  td { padding: 0.55rem 0.7rem; border-bottom: 1px solid var(--console-border); color: var(--console-ink-soft); }
  td code { color: var(--console-ink); }

  .create-user-form { display: grid; gap: 0.2rem; margin-top: 0.5rem; }
  .create-user-form label { font-size: 0.78rem; color: var(--console-ink-soft); margin-top: 0.5rem; }
  .create-user-form input, .create-user-form select, #dispatch-form input, #dispatch-form select, #agent-config-form input, #agent-config-form select {
    padding: 0.5rem 0.65rem; border-radius: 6px; border: 1px solid var(--console-border); background: var(--console-surface-raised); color: var(--console-ink);
  }

  .dispatch-result { background: var(--console-surface-raised); border: 1px solid var(--console-border); border-radius: 8px; padding: 0.7rem; font-size: 0.75rem; color: var(--console-ink-soft); white-space: pre-wrap; margin-top: 0.75rem; }

  .funnel-track { background: var(--console-surface-raised); border-radius: 99px; height: 8px; overflow: hidden; margin: 0.3rem 0; }
  .funnel-fill { display: block; height: 100%; background: var(--console-accent); border-radius: inherit; width: 0%; }
  .funnel-meta { display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--console-ink-soft); }
  .funnel-visual { list-style: none; padding: 0; margin: 0 0 1.1rem; }
  .lang-mix { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
  .lang-mix li { display: grid; grid-template-columns: 110px 1fr auto; align-items: center; gap: 0.6rem; font-size: 0.8rem; color: var(--console-ink-soft); }

  .campaign-list { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: 0.7rem; }
  .campaign-row { display: flex; justify-content: space-between; font-size: 0.85rem; color: var(--console-ink); }
  .campaign-bar { height: 6px; border-radius: 99px; background: var(--console-surface-raised); position: relative; overflow: hidden; margin: 0.3rem 0; }
  .campaign-bar::after { content: ""; position: absolute; inset: 0; width: var(--p, 0%); background: var(--console-accent); }

  .soon-card { text-align: left; }
  .soon-card h2::before { content: "🚧 "; }

  .handoff-list { display: grid; gap: 0.75rem; }
  .handoff-item { border: 1px solid var(--console-border); border-radius: 8px; padding: 0.8rem 1rem; }
  .qa-filter { font-size: 0.78rem; color: var(--console-ink-soft); display: flex; align-items: center; gap: 0.4rem; }

  @media (max-width: 900px) {
    .ops-shell { grid-template-columns: 1fr; }
    .ops-sidebar { position: static; height: auto; }
  }
</style>

<script>
  const TOKEN_KEY = 'shris_jwt';
  const ROLE_KEY = 'shris_role';
  const TENANT_KEY = 'shris_tenant';
  const DEMO_KEY = 'shris_demo_mode';

  const shell = document.querySelector('.ops-shell') as HTMLElement | null;
  const apiBase = shell?.dataset.apiBase || 'http://127.0.0.1:8787/v1';
  const traiBadge = document.getElementById('trai-badge');
  const apiBadge = document.getElementById('api-badge');
  const resultEl = document.getElementById('dispatch-result');
  const loginPanel = document.getElementById('login-panel');
  const authBlock = document.getElementById('ops-authenticated');
  const logoutBtn = document.getElementById('logout-btn');
  const loginError = document.getElementById('login-error');
  const demoToggle = document.getElementById('demo-toggle') as HTMLInputElement | null;
  const demoBanner = document.getElementById('demo-banner');

  function token(): string {
    return sessionStorage.getItem(TOKEN_KEY) || '';
  }

  function headers(json = false): HeadersInit {
    const h: Record<string, string> = { Accept: 'application/json' };
    if (json) h['Content-Type'] = 'application/json';
    if (token()) h.Authorization = `Bearer ${token()}`;
    return h;
  }

  function istHour(): number {
    const parts = new Intl.DateTimeFormat('en-GB', { hour: 'numeric', hour12: false, timeZone: 'Asia/Kolkata' }).formatToParts(new Date());
    return Number(parts.find((p) => p.type === 'hour')?.value ?? 0);
  }

  function updateTrai() {
    const hour = istHour();
    const open = hour >= 9 && hour < 21;
    if (traiBadge) {
      traiBadge.textContent = open ? `TRAI window: OPEN (${hour}:00 IST)` : `TRAI window: CLOSED (${hour}:00 IST)`;
      traiBadge.className = open ? 'badge badge-emerald' : 'badge badge-indigo';
    }
  }
  updateTrai();
  setInterval(updateTrai, 60000);

  function applyRole(role: string, tenant = sessionStorage.getItem(TENANT_KEY) || '') {
    sessionStorage.setItem(ROLE_KEY, role);
    const tenantWrap = document.getElementById('sidebar-tenant');
    const tenantName = document.getElementById('sidebar-tenant-name');
    const tenantRole = document.getElementById('sidebar-tenant-role');
    if (tenantWrap) tenantWrap.hidden = false;
    if (tenantName && tenant) tenantName.textContent = tenant;
    if (tenantRole) tenantRole.textContent = role;
    const dispatchCard = document.getElementById('dispatch-card');
    const usersCard = document.getElementById('users-card');
    if (dispatchCard) dispatchCard.hidden = role === 'viewer';
    if (usersCard) usersCard.hidden = role !== 'admin';
    const campForm = document.getElementById('create-campaign-form');
    if (campForm) campForm.hidden = role === 'viewer';
  }

  function showAuth(on: boolean) {
    if (loginPanel) loginPanel.hidden = on;
    if (authBlock) authBlock.hidden = !on;
    if (logoutBtn) logoutBtn.hidden = !on;
  }

  // ---------------- sidebar routing ----------------
  const navItems = Array.from(document.querySelectorAll<HTMLButtonElement>('.nav-item[data-panel]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.panel[data-panel]'));
  const topbarEyebrow = document.getElementById('topbar-eyebrow');
  const topbarTitle = document.getElementById('topbar-title');
  const soonTitle = document.getElementById('soon-title');
  const soonBody = document.getElementById('soon-body');

  const PANEL_TITLES: Record<string, [string, string]> = {
    overview: ['Overview', "Real-time performance across your AI voice operations"],
    agents: ['AI Workforce', 'Agent playbooks'],
    inbound: ['Communications', 'Inbound calls'],
    outbound: ['Communications', 'Outbound calls & dispatch'],
    conversations: ['Communications', 'Conversations & handoffs'],
    numbers: ['Communications', 'Phone numbers'],
    campaigns: ['Automation', 'Campaigns'],
    contacts: ['Business', 'Contacts'],
    integrations: ['Business', 'Integrations'],
    analytics: ['Intelligence', 'Analytics'],
    team: ['Admin', 'Team'],
    compliance: ['Admin', 'Security & compliance']
  };

  function selectPanel(key: string, trigger?: HTMLButtonElement) {
    for (const p of panels) p.hidden = p.dataset.panel !== key;
    for (const n of navItems) n.classList.toggle('active', n === trigger);
    if (key === 'soon' && trigger) {
      if (soonTitle) soonTitle.innerHTML = trigger.dataset.soonTitle || 'Not built yet';
      if (soonBody) soonBody.textContent = trigger.dataset.soonBody || '';
      if (topbarEyebrow) topbarEyebrow.textContent = 'Not built yet';
      if (topbarTitle) topbarTitle.textContent = trigger.dataset.soonTitle || '';
      return;
    }
    const meta = PANEL_TITLES[key];
    if (meta) {
      if (topbarEyebrow) topbarEyebrow.textContent = meta[0];
      if (topbarTitle) topbarTitle.textContent = meta[1];
    }
  }

  for (const item of navItems) {
    item.addEventListener('click', () => {
      const key = item.dataset.panel;
      if (!key) return;
      selectPanel(key, item);
    });
  }

  // ---------------- demo data ----------------
  const DEMO = {
    totalCalls: 128450, connectedCalls: 98765, conversations: 74321,
    avgDuration: '04:32', successRate: '62.4%', cost: '₹2,48,302',
    campaigns: 12, agents: 8, contacts: 124680, dnc: 8432, compliance: '98%'
  };

  let lastReal: {
    totalCalls: number; connectedCalls: number; conversations: number;
    successRate: string; campaigns: number; agents: number; contacts: number;
    dnc: string; compliance: string; avgDurationMs: number | null;
  } | null = null;

  function isDemo(): boolean {
    return localStorage.getItem(DEMO_KEY) === '1';
  }

  function fmt(n: number): string {
    return n.toLocaleString('en-IN');
  }

  function fmtDuration(ms: number): string {
    const totalSeconds = Math.round(ms / 1000);
    const m = Math.floor(totalSeconds / 60);
    const s = totalSeconds % 60;
    return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
  }

  function renderOverview() {
    const demo = isDemo();
    if (demoBanner) demoBanner.hidden = !demo;
    const set = (id: string, value: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = value;
    };
    if (demo) {
      set('kpi2-total-calls', fmt(DEMO.totalCalls));
      set('kpi2-connected-calls', fmt(DEMO.connectedCalls));
      set('kpi2-conversations', fmt(DEMO.conversations));
      set('kpi2-avg-duration', DEMO.avgDuration);
      set('kpi2-success-rate', DEMO.successRate);
      set('kpi2-cost', DEMO.cost);
      set('stat-campaigns', fmt(DEMO.campaigns));
      set('stat-agents', fmt(DEMO.agents));
      set('stat-contacts', fmt(DEMO.contacts));
      set('stat-dnc', fmt(DEMO.dnc));
      set('stat-compliance', DEMO.compliance);
      const avgSub = document.getElementById('kpi2-avg-duration-sub');
      const costSub = document.getElementById('kpi2-cost-sub');
      if (avgSub) avgSub.textContent = 'Sample value — Demo data is on.';
      if (costSub) costSub.textContent = 'Sample value — Demo data is on.';
      return;
    }
    const avgSub = document.getElementById('kpi2-avg-duration-sub');
    const costSub = document.getElementById('kpi2-cost-sub');
    if (costSub) costSub.textContent = 'Not tracked yet — no metering/billing subsystem.';
    set('kpi2-cost', '—');
    if (lastReal) {
      set('kpi2-total-calls', fmt(lastReal.totalCalls));
      set('kpi2-connected-calls', fmt(lastReal.connectedCalls));
      set('kpi2-conversations', fmt(lastReal.conversations));
      set('kpi2-success-rate', lastReal.successRate);
      set('stat-campaigns', fmt(lastReal.campaigns));
      set('stat-agents', fmt(lastReal.agents));
      set('stat-contacts', fmt(lastReal.contacts));
      set('stat-dnc', lastReal.dnc);
      set('stat-compliance', lastReal.compliance);
      if (lastReal.avgDurationMs === null) {
        set('kpi2-avg-duration', '—');
        if (avgSub) avgSub.textContent = 'No completed calls yet.';
      } else {
        set('kpi2-avg-duration', fmtDuration(lastReal.avgDurationMs));
        if (avgSub) avgSub.textContent = 'Across completed calls. Simulator calls time pipeline processing, not a live audio session.';
      }
    } else {
      set('kpi2-avg-duration', '—');
      if (avgSub) avgSub.textContent = 'Sign in to load.';
    }
  }

  demoToggle?.addEventListener('change', () => {
    localStorage.setItem(DEMO_KEY, demoToggle.checked ? '1' : '0');
    renderOverview();
  });
  if (demoToggle) demoToggle.checked = isDemo();
  renderOverview();

  async function probeApi() {
    try {
      const res = await fetch(`${apiBase}/health`);
      const data = await res.json() as {
        status?: string; mode?: string; traiOpen?: boolean; istHour?: number;
        tenant?: string; queueDepth?: number; hipaa?: { enabled?: boolean };
      };
      if (apiBadge) apiBadge.textContent = `API: ${data.status || 'ok'} (${data.mode || 'simulator'})`;
      const hipaaBadge = document.getElementById('hipaa-badge');
      if (hipaaBadge) {
        hipaaBadge.hidden = !data.hipaa?.enabled;
        hipaaBadge.textContent = data.hipaa?.enabled ? 'HIPAA mode' : '';
      }
    } catch {
      if (apiBadge) apiBadge.textContent = 'API: offline';
    }
  }

  async function refreshWorkspace() {
    const [kpisRes, callsRes, campRes, numRes, handoffRes, agentsRes, leadsRes, dncRes] = await Promise.all([
      fetch(`${apiBase}/kpis`, { headers: headers() }),
      fetch(`${apiBase}/calls`, { headers: headers() }),
      fetch(`${apiBase}/campaigns`, { headers: headers() }),
      fetch(`${apiBase}/numbers`, { headers: headers() }),
      fetch(`${apiBase}/handoffs`, { headers: headers() }),
      fetch(`${apiBase}/agents`, { headers: headers() }),
      fetch(`${apiBase}/leads`, { headers: headers() }),
      fetch(`${apiBase}/admin/dnd-snapshot`, { headers: headers() })
    ]);
    if (kpisRes.status === 401 || callsRes.status === 401) {
      sessionStorage.removeItem(TOKEN_KEY);
      showAuth(false);
      return;
    }
    const kpis = await kpisRes.json();
    const set = (id: string, value: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = value;
    };

    // Analytics panel (unchanged funnel/language mix)
    set('kpi-attempted', String(kpis.attempted ?? kpis.dispatched ?? 0));
    set('kpi-connected', String(kpis.connected ?? 0));
    set('kpi-qualified', String(kpis.qualified ?? 0));
    set('kpi-booked', String(kpis.booked ?? 0));
    set('funnel-d', String(kpis.attempted ?? kpis.dispatched ?? 0));
    set('funnel-c', String(kpis.connected ?? 0));
    set('funnel-q', String(kpis.qualified ?? 0));
    set('funnel-b', String(kpis.booked ?? 0));
    const attempted = Number(kpis.attempted ?? kpis.dispatched ?? 0) || 0;
    const stages = [
      ['d', 'Attempted', Number(kpis.attempted ?? kpis.dispatched ?? 0)],
      ['c', 'Connected', Number(kpis.connected ?? 0)],
      ['q', 'Qualified', Number(kpis.qualified ?? 0)],
      ['b', 'Booked', Number(kpis.booked ?? 0)]
    ] as const;
    const denom = Math.max(attempted, 1);
    for (const [id, label, value] of stages) {
      const fill = document.getElementById(`funnel-fill-${id}`);
      if (fill) fill.style.width = `${Math.min(100, Math.round((value / denom) * 100))}%`;
      const sr = document.getElementById(`funnel-${id}-label`);
      if (sr) sr.textContent = `${label} ${value} of ${attempted}`;
    }
    const mix = (kpis.languageMix ?? {}) as Record<string, number>;
    const langs = [
      ['en', 'en-IN', 'English'], ['hi', 'hi-IN', 'Hindi'], ['ta', 'ta-IN', 'Tamil'], ['te', 'te-IN', 'Telugu']
    ] as const;
    const langTotal = langs.reduce((n, [, key]) => n + Number(mix[key] ?? 0), 0) || 1;
    for (const [short, key, label] of langs) {
      const count = Number(mix[key] ?? 0);
      set(`lang-${short}`, String(count));
      const fill = document.getElementById(`lang-fill-${short}`);
      if (fill) fill.style.width = `${Math.min(100, Math.round((count / langTotal) * 100))}%`;
      const sr = document.getElementById(`lang-${short}-label`);
      if (sr) sr.textContent = `${label} ${count}`;
    }

    // Calls tables (outbound + inbound share the same persisted-call data today)
    const callsBody = await callsRes.json();
    const calls = (callsBody.calls || []) as Array<{
      id: string; status: string; disclosurePlayed: boolean;
      request: { to: string; agent_id: string }; qa?: { score: number };
    }>;
    const rowsHtml = calls.length
      ? calls.slice(0, 12).map((c) => `<tr>
          <td><code>${c.id}</code></td>
          <td>${c.request.agent_id}</td>
          <td>${c.request.to}</td>
          <td>${c.status}</td>
          <td>${c.disclosurePlayed ? 'Played' : '—'}</td>
          <td>${c.qa ? Math.round(c.qa.score * 100) + '%' : '—'}</td>
        </tr>`).join('')
      : '<tr><td colspan="6" class="muted">No persisted calls yet. Dispatch a simulator job.</td></tr>';
    const fleetBody = document.getElementById('fleet-body');
    if (fleetBody) fleetBody.innerHTML = rowsHtml;
    const fleetBodyInbound = document.getElementById('fleet-body-inbound');
    if (fleetBodyInbound) fleetBodyInbound.innerHTML = rowsHtml;

    const qaBody = document.getElementById('qa-body');
    if (qaBody) {
      qaBody.innerHTML = calls.length
        ? calls.slice(0, 12).map((c) => `<tr>
            <td><code>${c.id}</code></td>
            <td>${c.qa ? Math.round(c.qa.score * 100) + '%' : '—'}</td>
            <td>${c.disclosurePlayed ? 'Played' : '—'}</td>
            <td>${c.qa ? '' : 'No QA scored yet'}</td>
          </tr>`).join('')
        : '<tr><td colspan="4" class="muted">No persisted calls yet.</td></tr>';
    }

    // Campaigns
    const camps = await campRes.json();
    const campaigns = (camps.campaigns || []) as Array<{ name: string; domain: string; connected: number; blocked: number }>;
    const list = document.getElementById('campaign-list');
    if (list) {
      list.innerHTML = campaigns.map((c) => {
        const total = c.connected + c.blocked || 1;
        const p = Math.round((c.connected / total) * 100);
        return `<li>
          <div class="campaign-row"><strong>${c.name}</strong><span>${p}%</span></div>
          <div class="campaign-bar" style="--p:${p}%"></div>
          <p class="muted">${c.domain} · ${c.connected} connected · ${c.blocked} blocked</p>
        </li>`;
      }).join('');
    }

    // Numbers
    if (numRes.ok) {
      const nums = await numRes.json() as { numbers: Array<{ id: string; e164: string; label: string; active: boolean; rotatedAt?: string }> };
      const nbody = document.getElementById('numbers-body');
      const canRotate = sessionStorage.getItem(ROLE_KEY) !== 'viewer';
      if (nbody) {
        nbody.innerHTML = (nums.numbers || []).map((n) => `<tr>
          <td>${n.label}</td><td><code>${n.e164}</code></td>
          <td>${n.active ? 'active' : 'idle'}${n.rotatedAt ? ' · rotated' : ''}</td>
          <td>${canRotate ? `<button type="button" class="btn btn-outline btn-sm did-rotate" data-did="${n.id}">Rotate</button>` : 'read-only'}</td>
        </tr>`).join('') || '<tr><td colspan="4" class="muted">No simulator DIDs.</td></tr>';
      }
    }

    // Handoffs
    if (handoffRes.ok) {
      const payload = await handoffRes.json() as {
        handoffs: Array<{ id: string; domain: string; assignedTo?: string; handoffStatus?: string; turns: Array<{ speaker: string; text: string }> }>;
      };
      const box = document.getElementById('handoff-list');
      const canAct = sessionStorage.getItem(ROLE_KEY) !== 'viewer';
      const rows = payload.handoffs || [];
      if (box) {
        box.innerHTML = rows.length
          ? rows.map((h) => {
              const last = [...h.turns].reverse().find((t) => t.speaker === 'customer')?.text || 'Caller requested a specialist.';
              const actions = canAct
                ? `<div class="handoff-actions">
                    <button type="button" class="btn btn-outline btn-sm handoff-accept" data-id="${h.id}">Accept</button>
                    <label class="sr-only" for="handoff-reply-${h.id}">Specialist reply</label>
                    <input id="handoff-reply-${h.id}" type="text" data-reply-for="${h.id}" placeholder="Reply as specialist" />
                    <button type="button" class="btn btn-indigo btn-sm handoff-reply" data-id="${h.id}">Send reply</button>
                    <button type="button" class="btn btn-outline btn-sm handoff-resolve" data-id="${h.id}">Resolve</button>
                  </div>`
                : '<p class="muted">Viewer: queue is read-only.</p>';
              return `<article class="handoff-item">
                <h3><code>${h.id}</code> · ${h.domain} · ${h.handoffStatus || 'queued'}</h3>
                <p>${last}</p>
                <p class="muted">${h.assignedTo ? `Assigned to ${h.assignedTo}` : 'Unassigned'}</p>
                ${actions}
              </article>`;
            }).join('')
          : '<p class="muted">No live handoffs. Ask for a human in the voice loop.</p>';
      }
    }

    // Team (admin only)
    const usersCard = document.getElementById('users-card');
    if (usersCard && !usersCard.hidden) {
      const usersRes = await fetch(`${apiBase}/users`, { headers: headers() });
      const usersBody = await usersRes.json();
      const ubody = document.getElementById('users-body');
      if (ubody && usersRes.ok) {
        const users = (usersBody.users || []) as Array<{ email: string; name: string; role: string }>;
        ubody.innerHTML = users.map((u) => `<tr><td><code>${u.email}</code></td><td>${u.name}</td><td>${u.role}</td></tr>`).join('');
      }
    }

    // Integrations (admin only, best-effort)
    const intRes = await fetch(`${apiBase}/integrations`, { headers: headers() });
    const ierr = document.getElementById('integrations-error');
    const ibody = document.getElementById('integrations-body');
    const inote = document.getElementById('integrations-note');
    if (!intRes.ok) {
      if (ierr) ierr.textContent = 'Could not load integrations (admin only).';
    } else {
      if (ierr) ierr.textContent = '';
      const payload = await intRes.json() as { note?: string; providers?: Array<{ label: string; mode: string; env: string[] }> };
      if (inote) inote.textContent = payload.note || '';
      if (ibody) {
        ibody.innerHTML = (payload.providers || []).map((p) => `<tr>
          <td>${p.label}</td><td>${p.mode}</td><td><code>${(p.env || []).join(', ')}</code></td>
        </tr>`).join('');
      }
    }

    // Agents (used by both the Agents panel and the Overview count)
    let agentsCount = 0;
    if (agentsRes.ok) {
      const payload = await agentsRes.json() as {
        agents: Array<{ id: string; name: string; disclosure: string; qualifyScript: string; language: string }>;
      };
      agentsCount = payload.agents.length;
      const select = document.getElementById('agent-select') as HTMLSelectElement | null;
      if (select) {
        const keep = select.value;
        select.innerHTML = payload.agents.map((a) => `<option value="${a.id}">${a.name}</option>`).join('');
        if (keep && [...select.options].some((o) => o.value === keep)) select.value = keep;
        const current = payload.agents.find((a) => a.id === select.value);
        const disc = document.getElementById('agent-disclosure') as HTMLInputElement | null;
        const script = document.getElementById('agent-script') as HTMLInputElement | null;
        const lang = document.getElementById('agent-language') as HTMLSelectElement | null;
        if (current && disc) disc.value = current.disclosure;
        if (current && script) script.value = current.qualifyScript;
        if (current && lang) lang.value = current.language;
        select.onchange = () => {
          const next = payload.agents.find((a) => a.id === select.value);
          if (next && disc) disc.value = next.disclosure;
          if (next && script) script.value = next.qualifyScript;
          if (next && lang) lang.value = next.language;
        };
      }
    }

    // Contacts (leads) — read once, reused below for the Overview count too
    type LeadsPayload = { leads: Array<{ name: string; phone: string; source: string; domain: string; createdAt: string }> };
    let leadsPayload: LeadsPayload | null = null;
    if (leadsRes.ok) {
      leadsPayload = await leadsRes.json() as LeadsPayload;
      const payload = leadsPayload;
      const cbody = document.getElementById('contacts-body');
      if (cbody) {
        cbody.innerHTML = payload.leads.length
          ? payload.leads.slice(0, 30).map((l) => `<tr>
              <td>${l.name}</td><td><code>${l.phone}</code></td><td>${l.source}</td><td>${l.domain}</td>
              <td>${new Date(l.createdAt).toLocaleString('en-IN')}</td>
            </tr>`).join('')
          : '<tr><td colspan="5" class="muted">No leads yet.</td></tr>';
      }
    }

    // DNC snapshot (admin only, best-effort — not everyone can see it)
    let dncCount: string = '—';
    if (dncRes.ok) {
      const meta = await dncRes.json() as { count: number };
      dncCount = fmt(meta.count);
    }

    // Audit log (admin only, best-effort)
    const auditRes = await fetch(`${apiBase}/audit`, { headers: headers() });
    const auditBody = document.getElementById('audit-body');
    const auditError = document.getElementById('audit-error');
    if (auditRes.ok) {
      if (auditError) auditError.textContent = '';
      const payload = await auditRes.json() as { events: Array<{ at: string; actor: string; action: string; detail: unknown }> };
      if (auditBody) {
        auditBody.innerHTML = payload.events.length
          ? payload.events.slice(0, 40).map((e) => `<tr>
              <td>${new Date(e.at).toLocaleString('en-IN')}</td><td>${e.actor}</td><td>${e.action}</td>
              <td><code>${JSON.stringify(e.detail).slice(0, 80)}</code></td>
            </tr>`).join('')
          : '<tr><td colspan="4" class="muted">No audit events yet.</td></tr>';
      }
    } else if (auditError) {
      auditError.textContent = 'Could not load audit log (admin only).';
    }

    // Overview KPI numbers, computed from real data above
    const dispatched = Number(kpis.dispatched ?? 0) || 0;
    const connected = Number(kpis.connected ?? 0) || 0;
    const blocked = Number(kpis.blocked ?? 0) || 0;
    const blockedTrai = Number(kpis.blockedTrai ?? 0) || 0;
    const blockedDnd = Number(kpis.blockedDnd ?? 0) || 0;
    const disclosureRate = Number(kpis.disclosureRate ?? 1);
    const successRate = connected + blocked > 0 ? `${Math.round((connected / (connected + blocked)) * 1000) / 10}%` : '—';
    const complianceParts = [
      disclosureRate,
      1 - blockedDnd / Math.max(1, dispatched),
      1 - blockedTrai / Math.max(1, dispatched)
    ];
    const complianceScore = `${Math.round((complianceParts.reduce((a, b) => a + b, 0) / complianceParts.length) * 100)}%`;
    const avgDurationMs = typeof kpis.avgDurationMs === 'number' ? kpis.avgDurationMs : null;

    let conversationsCount = 0;
    const convRes = await fetch(`${apiBase}/conversations`, { headers: headers() });
    if (convRes.ok) {
      const payload = await convRes.json() as { conversations: unknown[] };
      conversationsCount = payload.conversations.length;
    }

    const contactsCount = leadsPayload?.leads.length ?? 0;

    lastReal = {
      totalCalls: dispatched,
      connectedCalls: connected,
      conversations: conversationsCount,
      successRate,
      campaigns: campaigns.length,
      agents: agentsCount,
      contacts: contactsCount,
      dnc: dncCount,
      compliance: complianceScore,
      avgDurationMs
    };
    renderOverview();
  }

  document.getElementById('login-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.target as HTMLFormElement;
    const email = (form.elements.namedItem('email') as HTMLInputElement).value;
    const password = (form.elements.namedItem('password') as HTMLInputElement).value;
    if (loginError) loginError.textContent = '';
    try {
      const res = await fetch(`${apiBase}/auth/login`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email, password })
      });
      const data = await res.json();
      if (!res.ok) {
        if (loginError) loginError.textContent = 'Invalid credentials. Check Shris-ai-app .env.example.';
        return;
      }
      sessionStorage.setItem(TOKEN_KEY, data.token);
      if (data.tenant) sessionStorage.setItem(TENANT_KEY, data.tenant);
      applyRole(data.role || 'admin', data.tenant);
      showAuth(true);
      await refreshWorkspace();
    } catch {
      if (loginError) loginError.textContent = 'Runtime offline. Start Shris-ai-app on port 8787.';
    }
  });

  logoutBtn?.addEventListener('click', () => {
    sessionStorage.removeItem(TOKEN_KEY);
    sessionStorage.removeItem(ROLE_KEY);
    sessionStorage.removeItem(TENANT_KEY);
    showAuth(false);
  });

  document.getElementById('dispatch-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.target as HTMLFormElement;
    const to = (form.elements.namedItem('to') as HTMLInputElement).value;
    const agent_id = (form.elements.namedItem('agent_id') as HTMLSelectElement).value;
    if (resultEl) resultEl.textContent = 'Evaluating TRAI / DND / DLT / disclosure…';
    try {
      const res = await fetch(`${apiBase}/calls/dispatch`, {
        method: 'POST', headers: headers(true), body: JSON.stringify({ to, agent_id, simulate: true })
      });
      const data = await res.json();
      if (resultEl) resultEl.textContent = JSON.stringify(data, null, 2);
      await refreshWorkspace();
    } catch {
      if (resultEl) resultEl.textContent = 'Dispatch failed — runtime offline?';
    }
  });

  document.getElementById('voice-loop-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.target as HTMLFormElement;
    const domain = (form.elements.namedItem('domain') as HTMLSelectElement).value;
    const text = (form.elements.namedItem('text') as HTMLInputElement).value;
    const out = document.getElementById('voice-loop-result');
    if (out) out.textContent = 'Starting conversation…';
    try {
      const created = await fetch(`${apiBase}/conversations`, {
        method: 'POST', headers: headers(true), body: JSON.stringify({ domain })
      });
      const conv = await created.json();
      const turn = await fetch(`${apiBase}/conversations/${conv.conversation.id}/turns`, {
        method: 'POST', headers: headers(true), body: JSON.stringify({ text })
      });
      const data = await turn.json();
      if (out) out.textContent = JSON.stringify(data, null, 2);
    } catch {
      if (out) out.textContent = 'Voice loop failed — runtime offline?';
    }
  });

  document.getElementById('create-campaign-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.target as HTMLFormElement;
    const name = (form.elements.namedItem('name') as HTMLInputElement).value;
    const domain = (form.elements.namedItem('domain') as HTMLInputElement).value;
    const agent_id = (form.elements.namedItem('agent_id') as HTMLSelectElement).value;
    const err = document.getElementById('campaign-error');
    if (err) err.textContent = '';
    try {
      const res = await fetch(`${apiBase}/campaigns`, {
        method: 'POST', headers: headers(true), body: JSON.stringify({ name, domain, agent_id })
      });
      if (!res.ok) {
        if (err) err.textContent = 'Could not create campaign.';
        return;
      }
      form.reset();
      await refreshWorkspace();
    } catch {
      if (err) err.textContent = 'Runtime offline.';
    }
  });

  document.getElementById('agent-config-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.target as HTMLFormElement;
    const id = (document.getElementById('agent-select') as HTMLSelectElement).value;
    const language = (form.elements.namedItem('language') as HTMLSelectElement).value;
    const disclosure = (form.elements.namedItem('disclosure') as HTMLInputElement).value;
    const qualifyScript = (form.elements.namedItem('qualifyScript') as HTMLInputElement).value;
    const err = document.getElementById('agents-error');
    if (err) err.textContent = '';
    try {
      const res = await fetch(`${apiBase}/agents/${id}`, {
        method: 'PUT', headers: headers(true), body: JSON.stringify({ language, disclosure, qualifyScript })
      });
      if (!res.ok && err) err.textContent = 'Could not save (admin only).';
    } catch {
      if (err) err.textContent = 'Runtime offline.';
    }
  });

  document.getElementById('create-user-form')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.target as HTMLFormElement;
    const email = (form.elements.namedItem('email') as HTMLInputElement).value;
    const name = (form.elements.namedItem('name') as HTMLInputElement).value;
    const role = (form.elements.namedItem('role') as HTMLSelectElement).value;
    const password = (form.elements.namedItem('password') as HTMLInputElement).value;
    const err = document.getElementById('users-error');
    if (err) err.textContent = '';
    try {
      const res = await fetch(`${apiBase}/users`, {
        method: 'POST', headers: headers(true), body: JSON.stringify({ email, name, role, password })
      });
      if (!res.ok) {
        if (err) err.textContent = 'Could not create user (admin only, or already exists).';
        return;
      }
      form.reset();
      await refreshWorkspace();
    } catch {
      if (err) err.textContent = 'Runtime offline.';
    }
  });

  document.addEventListener('click', async (event) => {
    const target = event.target as HTMLElement;
    const rotateBtn = target.closest<HTMLButtonElement>('.did-rotate');
    if (rotateBtn) {
      await fetch(`${apiBase}/numbers/rotate`, { method: 'POST', headers: headers(true), body: JSON.stringify({ id: rotateBtn.dataset.did }) });
      await refreshWorkspace();
      return;
    }
    const acceptBtn = target.closest<HTMLButtonElement>('.handoff-accept');
    if (acceptBtn) {
      await fetch(`${apiBase}/handoffs/${acceptBtn.dataset.id}/accept`, { method: 'POST', headers: headers(true) });
      await refreshWorkspace();
      return;
    }
    const resolveBtn = target.closest<HTMLButtonElement>('.handoff-resolve');
    if (resolveBtn) {
      await fetch(`${apiBase}/handoffs/${resolveBtn.dataset.id}/resolve`, { method: 'POST', headers: headers(true) });
      await refreshWorkspace();
      return;
    }
    const replyBtn = target.closest<HTMLButtonElement>('.handoff-reply');
    if (replyBtn) {
      const id = replyBtn.dataset.id;
      const input = document.querySelector<HTMLInputElement>(`[data-reply-for="${id}"]`);
      if (input && input.value.trim()) {
        await fetch(`${apiBase}/handoffs/${id}/reply`, { method: 'POST', headers: headers(true), body: JSON.stringify({ text: input.value.trim() }) });
        input.value = '';
        await refreshWorkspace();
      }
    }
  });

  if (token()) {
    applyRole(sessionStorage.getItem(ROLE_KEY) || 'admin');
    showAuth(true);
    refreshWorkspace();
  }
  probeApi();
  setInterval(probeApi, 30000);
</script>
