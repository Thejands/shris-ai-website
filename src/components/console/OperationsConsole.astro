  .sidebar-nav { display: flex; flex-direction: column; gap: 0.1rem; }
  .nav-group {
    margin: 0.9rem 0.5rem 0.35rem;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
