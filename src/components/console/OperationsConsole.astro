    overflow-y: auto;
  }
  .sidebar-brand { display: flex; align-items: center; gap: 0.6rem; padding: 0.4rem 0.5rem 1.1rem; }
  .brand-mark { font-family: var(--font-mono); color: var(--console-accent); font-size: 1.1rem; }
  .brand-name { margin: 0; font-weight: 700; font-size: 0.95rem; color: var(--console-ink); }
  .brand-sub { margin: 0; font-size: 0.7rem; color: var(--console-muted); }

  .sidebar-tenant {
