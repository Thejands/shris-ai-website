---
interface Props {
  variant?: 'header' | 'footer';
  href?: string;
}

const { variant = 'footer', href } = Astro.props;
const Tag = href ? 'a' : 'div';
const tagProps = href ? { href, 'aria-label': 'Shris AI Home' } : {};
---

<Tag class={`brand-lockup brand-lockup--${variant}`} {...tagProps}>
  <div class="brand-row">
    <svg class="brand-motif-icon" width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect width="28" height="28" rx="8" fill="#111625"/>
      <path d="M7 14C7 10.134 10.134 7 14 7C17.866 7 21 10.134 21 14C21 17.866 17.866 21 14 21" stroke="#6366F1" stroke-width="2.5" stroke-linecap="round"/>
      <circle cx="14" cy="14" r="3" fill="#F59E0B"/>
    </svg>
    <span class="brand-text">SHRIS <span class="brand-ai">AI</span></span>
  </div>
  <p class="brand-tagline">A Thejands Company</p>
</Tag>

<style>
  .brand-lockup {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.2rem;
    text-decoration: none;
  }

  .brand-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .brand-text {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--shris-navy-950);
    line-height: 1;
  }

  .brand-ai {
    color: var(--shris-indigo);
  }

  .brand-tagline {
    margin: 0;
    width: 100%;
    font-family: var(--font-sans);
    font-size: 0.58rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    line-height: 1.2;
    text-align: center;
    color: var(--shris-tx-tertiary);
    white-space: nowrap;
  }

  .brand-lockup--footer .brand-text {
    font-size: 1.2rem;
  }

  .brand-lockup--footer .brand-tagline {
    font-size: 0.62rem;
    letter-spacing: 0.02em;
  }

  .brand-lockup--header .brand-tagline {
    color: #94A3B8;
  }

  @media (max-width: 640px) {
    .brand-lockup--header .brand-tagline {
      display: none;
    }
  }
</style>
