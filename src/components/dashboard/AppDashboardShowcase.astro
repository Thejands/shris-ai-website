---
---

<section class="section-wrapper dashboard-showcase-section" id="dashboard-preview">
  <div class="container">
    <div class="section-header reveal-fade-up">
      <div class="eyebrow-container">
        <div class="eyebrow-line"></div>
        <p class="eyebrow-text">Agentic Communications Console</p>
        <div class="eyebrow-line"></div>
      </div>
      <h2>Unified mission control for your autonomous voice fleet.</h2>
      <p class="lead">
        Orchestrate national-scale outbound campaigns, monitor real-time conversational latency, inspect structured entity extractions, and sync CRM records in one sovereign workspace.
      </p>
    </div>

    <!-- Action Bar & Agentic Communication Buttons Above Screenshot -->
    <div class="dashboard-action-bar reveal-fade-up">
      <div class="action-buttons-group">
        <a href="/app" class="btn btn-indigo btn-lg pulse-glow-btn">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
          <span>Launch Agentic Communications Demo</span>
        </a>

        <div class="quick-feature-pills">
          <span class="feat-pill active">
            <span class="pulse-dot"></span>
            <span>Real-Time Telephony Stream</span>
          </span>
          <span class="feat-pill">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Live CRM Bi-directional Sync</span>
          </span>
          <span class="feat-pill">
            <span class="badge badge-indigo" style="font-size: 0.65rem;">276ms</span>
            <span>Sub-300ms Turn Latency</span>
          </span>
        </div>
      </div>
    </div>

    <!-- Dashboard App Window Frame with Glow -->
    <div class="dashboard-frame-wrapper reveal-fade-up">
      <!-- Glow effect behind mockup -->
      <div class="frame-ambient-glow" aria-hidden="true"></div>

      <div class="dashboard-mockup-card">
        <!-- Mockup Window Bar -->
        <div class="mockup-window-bar">
          <div class="window-dots">
            <span class="dot dot-red"></span>
            <span class="dot dot-yellow"></span>
            <span class="dot dot-green"></span>
          </div>

          <div class="window-title-chip">
            <span class="pulse-dot"></span>
            <span>Shris AI • Sovereign Voice Operations Workspace (Active Campaign)</span>
          </div>

          <div class="window-meta-right">
            <span class="badge badge-emerald">Carrier Telephony: Connected</span>
          </div>
        </div>

        <!-- Dashboard Image Render -->
        <div class="mockup-image-container">
          <img 
            src="/app_dashboard_screenshot.png" 
            alt="Shris AI Agentic Communications Dashboard Console showing live call metrics, campaign orchestrator, agent fleet status, and real-time CRM sync"
            class="dashboard-screenshot-img"
            loading="lazy"
            decoding="async"
            fetchpriority="low"
            width="1920"
            height="1080"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .dashboard-showcase-section {
    padding-top: 2rem;
    padding-bottom: clamp(4rem, 8vw, 7rem);
    position: relative;
  }

  .dashboard-action-bar {
    display: flex;
    justify-content: center;
    margin-bottom: 2.5rem;
  }

  .action-buttons-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .pulse-glow-btn {
    box-shadow: 0 4px 20px rgba(99, 102, 241, 0.4), 0 0 0 1px rgba(255, 255, 255, 0.2);
    transition: all 0.3s ease;
  }

  .pulse-glow-btn:hover {
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 8px 30px rgba(99, 102, 241, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.3);
  }

  .quick-feature-pills {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .feat-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.15rem;
    background: #FFFFFF;
    border: 1px solid var(--shris-border);
    border-radius: var(--radius-full);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--shris-tx-secondary);
    box-shadow: var(--shadow-sm);
  }

  .feat-pill.active {
    background: #111625;
    color: #FFFFFF;
    border-color: rgba(255, 255, 255, 0.15);
  }

  /* Mockup Frame */
  .dashboard-frame-wrapper {
    position: relative;
    max-width: 1180px;
    margin: 0 auto;
  }

  .frame-ambient-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 90%;
    height: 90%;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.18) 0%, rgba(245, 158, 11, 0.08) 50%, transparent 70%);
    filter: blur(60px);
    z-index: 0;
    pointer-events: none;
  }

  .dashboard-mockup-card {
    position: relative;
    z-index: 1;
    background: #0B0E17;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-2xl);
    overflow: hidden;
    box-shadow: 0 25px 80px rgba(11, 14, 23, 0.5), 0 0 0 1px rgba(99, 102, 241, 0.25);
  }

  .mockup-window-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.25rem;
    background: #111625;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .window-dots {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }

  .dot-red { background: #FF5F56; }
  .dot-yellow { background: #FFBD2E; }
  .dot-green { background: #27C93F; }

  .window-title-chip {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: #94A3B8;
  }

  .mockup-image-container {
    position: relative;
    width: 100%;
    line-height: 0;
    background: #0B0E17;
  }

  .dashboard-screenshot-img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 0 0 var(--radius-2xl) var(--radius-2xl);
  }

  @media (max-width: 768px) {
    .window-meta-right {
      display: none;
    }
  }

  /* Small phones: the long demo label wraps instead of widening the page. */
  @media (max-width: 480px) {
    .action-buttons-group {
      width: 100%;
      gap: 1rem;
    }

    .pulse-glow-btn {
      max-width: 100%;
      white-space: normal;
      text-align: center;
      padding-inline: 1.25rem;
    }

    .quick-feature-pills {
      justify-content: center;
    }
  }
</style>
