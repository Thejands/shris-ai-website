---
import Layout from '../layouts/Layout.astro';
import Header from '../components/navigation/Header.astro';
import Footer from '../components/navigation/Footer.astro';
import VoiceIntelligence from '../components/voice/VoiceIntelligence.astro';
import MultilingualEngine from '../components/voice/MultilingualEngine.astro';
import ScaleArchitecture from '../components/enterprise/ScaleArchitecture.astro';
import EnterpriseSecurity from '../components/enterprise/EnterpriseSecurity.astro';
import HumanEscalation from '../components/enterprise/HumanEscalation.astro';
---

<Layout 
  title="Platform & Voice Architecture | Shris AI"
  description="Full-stack sovereign conversational voice runtime engineered by Thejands. Sub-300ms latency, 10+ Indian languages, autonomous system actions, and enterprise data boundaries."
>
  <Header />

  <main id="main-content" style="padding-top: 5rem;">
    <!-- 01. Voice Intelligence & Latency Stack -->
    <VoiceIntelligence headingLevel="h1" />

    <!-- 02. Multilingual Voice Engine (10+ Languages) -->
    <MultilingualEngine />

    <!-- 03. Human Escalation (Warm Transfer Protocol) -->
    <HumanEscalation />

    <!-- 04. Scale & Distributed Telephony Architecture -->
    <ScaleArchitecture />

    <!-- 05. Enterprise Security & Zero Retention -->
    <EnterpriseSecurity />
  </main>

  <Footer />
</Layout>
