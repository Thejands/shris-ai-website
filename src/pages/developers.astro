---
import Layout from '../layouts/Layout.astro';
import Header from '../components/navigation/Header.astro';
import Footer from '../components/navigation/Footer.astro';
import DeveloperConsole from '../components/developer/DeveloperConsole.astro';
import AnalyticsDashboard from '../components/analytics/AnalyticsDashboard.astro';
---

<Layout 
  title="Developers & APIs | Shris AI"
  description="Programmable conversational voice intelligence. Trigger outbound calls, stream full-duplex audio via WebSockets, and build with Python and Node.js SDKs."
>
  <Header />

  <main id="main-content" style="padding-top: 5rem;">
    <!-- 01. Developer Code Snippets & SDKs -->
    <DeveloperConsole />

    <!-- 02. Real-Time Telemetry & Observability Dashboard -->
    <AnalyticsDashboard />
  </main>

  <Footer />
</Layout>
