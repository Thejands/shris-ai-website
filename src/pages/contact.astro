---
import Layout from '../layouts/Layout.astro';
import Header from '../components/navigation/Header.astro';
import Footer from '../components/navigation/Footer.astro';
---

<Layout 
  title="Contact Sales & Enterprise Consultation — Shris AI"
  description="Speak with our enterprise voice architects to design, benchmark, and deploy sovereign AI voice workforce solutions for your business."
>
  <Header />

  <main id="main-content" style="padding-top: 5.5rem;">
    <section class="section-wrapper">
      <div class="container">
        <div class="grid-2" style="align-items: start; gap: 3.5rem;">
          <!-- Left: Info & Pitch -->
          <div>
            <div class="eyebrow-container" style="align-items: flex-start;">
              <p class="eyebrow-text" style="padding: 0;">Enterprise Consultation</p>
              <div class="eyebrow-line" style="margin-left: 0;"></div>
            </div>
            <h1 style="font-size: clamp(2.5rem, 5vw, 3.75rem); color: #1E2033; margin-bottom: 1.25rem; line-height: 1.1;">
              Let's build your sovereign voice workforce.
            </h1>
            <p class="lead" style="margin-bottom: 2rem;">
              Whether you are scaling 10,000 or 10,000,000 calls per day, our solution architects will partner with your engineering and operations teams.
            </p>

            <div style="display: flex; flex-direction: column; gap: 1.25rem;">
              <div class="card-light" style="padding: 1.25rem;">
                <strong style="color: #1E2033; display: block; margin-bottom: 0.25rem;">Custom Model Fine-Tuning</strong>
                <p style="font-size: 0.88rem; color: var(--sf-tx-secondary); margin: 0;">
                  Train dedicated acoustic and vocabulary models for specialized industry terminology.
                </p>
              </div>

              <div class="card-light" style="padding: 1.25rem;">
                <strong style="color: #1E2033; display: block; margin-bottom: 0.25rem;">Dedicated VPC & Private Cloud</strong>
                <p style="font-size: 0.88rem; color: var(--sf-tx-secondary); margin: 0;">
                  Deploy within your isolated AWS, Azure, or GCP Virtual Private Cloud with zero data retention.
                </p>
              </div>

              <div class="card-light" style="padding: 1.25rem;">
                <strong style="color: #1E2033; display: block; margin-bottom: 0.25rem;">Direct Telephony SIP Trunking</strong>
                <p style="font-size: 0.88rem; color: var(--sf-tx-secondary); margin: 0;">
                  Low-latency carrier-grade interconnects with high-concurrency elastic bursting.
                </p>
              </div>
            </div>
          </div>

          <!-- Right: Contact Form -->
          <div class="card-dark" style="padding: clamp(1.5rem, 3vw, 2.5rem);">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; padding-bottom: 0.75rem; border-bottom: 1px solid rgba(255,255,255,0.08);">
              <span style="font-family: var(--font-mono); font-size: 0.75rem; color: #A5BBFC; font-weight: 700;">REQUEST CONSULTATION</span>
              <span class="badge badge-emerald">Priority Response &lt; 2h</span>
            </div>

            <form id="contact-form" style="display: flex; flex-direction: column; gap: 1.25rem;">
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div>
                  <label style="font-family: var(--font-mono); font-size: 0.7rem; color: #A5BBFC; display: block; margin-bottom: 0.35rem;">FIRST NAME</label>
                  <input type="text" required placeholder="Rohan" style="width: 100%; padding: 0.75rem 1rem; background: #141624; border: 1px solid rgba(255,255,255,0.12); border-radius: 8px; color: #FFFFFF; font-size: 0.88rem; outline: none;" />
                </div>
                <div>
                  <label style="font-family: var(--font-mono); font-size: 0.7rem; color: #A5BBFC; display: block; margin-bottom: 0.35rem;">LAST NAME</label>
                  <input type="text" required placeholder="Sharma" style="width: 100%; padding: 0.75rem 1rem; background: #141624; border: 1px solid rgba(255,255,255,0.12); border-radius: 8px; color: #FFFFFF; font-size: 0.88rem; outline: none;" />
                </div>
              </div>

              <div>
                <label style="font-family: var(--font-mono); font-size: 0.7rem; color: #A5BBFC; display: block; margin-bottom: 0.35rem;">WORK EMAIL</label>
                <input type="email" required placeholder="rohan@enterprise.com" style="width: 100%; padding: 0.75rem 1rem; background: #141624; border: 1px solid rgba(255,255,255,0.12); border-radius: 8px; color: #FFFFFF; font-size: 0.88rem; outline: none;" />
              </div>

              <div>
                <label style="font-family: var(--font-mono); font-size: 0.7rem; color: #A5BBFC; display: block; margin-bottom: 0.35rem;">MONTHLY CALL VOLUME</label>
                <select style="width: 100%; padding: 0.75rem 1rem; background: #141624; border: 1px solid rgba(255,255,255,0.12); border-radius: 8px; color: #FFFFFF; font-size: 0.88rem; outline: none;">
                  <option>10,000 – 50,000 calls / month</option>
                  <option>50,000 – 250,000 calls / month</option>
                  <option>250,000 – 1,000,000 calls / month</option>
                  <option>1,000,000+ calls / month (National Scale)</option>
                </select>
              </div>

              <div>
                <label style="font-family: var(--font-mono); font-size: 0.7rem; color: #A5BBFC; display: block; margin-bottom: 0.35rem;">PROJECT OBJECTIVES & REQUIREMENTS</label>
                <textarea rows="4" placeholder="Tell us about your customer call workflows and systems..." style="width: 100%; padding: 0.75rem 1rem; background: #141624; border: 1px solid rgba(255,255,255,0.12); border-radius: 8px; color: #FFFFFF; font-size: 0.88rem; outline: none;"></textarea>
              </div>

              <button type="submit" class="btn btn-filled btn-lg" style="width: 100%; margin-top: 0.5rem;">
                <span>Schedule Enterprise Consultation</span>
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
