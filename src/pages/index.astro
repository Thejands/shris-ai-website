---
import Layout from '../layouts/Layout.astro';
import Header from '../components/navigation/Header.astro';
import Footer from '../components/navigation/Footer.astro';
import Hero from '../components/hero/Hero.astro';
import MetricsStrip from '../components/hero/MetricsStrip.astro';
---

<Layout 
  title="Shris AI — India's Sovereign AI Voice Platform"
  description="Built on sovereign compute. Powered by frontier-class conversational agents. Delivering population-scale enterprise voice impact."
>
  <Header />

  <main id="main-content">
    <!-- Hero Section + Live 2-Way Voice Studio -->
    <Hero />

    <!-- Population-Scale Metrics Strip -->
    <MetricsStrip />

    <!-- 3 Sovereign Core Pillars -->
    <section class="section-wrapper" id="pillars">
      <div class="container">
        <div class="section-header reveal-fade-up">
          <div class="eyebrow-container">
            <div class="eyebrow-line"></div>
            <p class="eyebrow-text">SOVEREIGN AI WORKFORCE</p>
            <div class="eyebrow-line"></div>
          </div>
          <h2>AI voice intelligence built for India and the world.</h2>
          <p class="lead">
            A full-stack conversational voice runtime engineered for sub-300ms latency, Indian accents and code-mixing, and autonomous business system execution.
          </p>
        </div>

        <div class="pillars-3-grid">
          <div class="pillar-box card-light reveal-stagger-child">
            <div class="pillar-pill badge badge-indigo">Sovereign Voice Compute</div>
            <h3 class="pillar-box-title">Sub-300ms Full Duplex</h3>
            <p class="pillar-box-desc">
              Streaming acoustic models with instant barge-in interruption handling, zero awkward pauses, and human vocal warmth.
            </p>
            <a href="/platform" class="learn-link">Explore Platform ➔</a>
          </div>

          <div class="pillar-box card-light reveal-stagger-child">
            <div class="pillar-pill badge badge-indigo">10+ Regional Languages</div>
            <h3 class="pillar-box-title">Dialects & Code-Mixing</h3>
            <p class="pillar-box-desc">
              Trained on real Indian speech patterns, regional inflections, and seamless switching between Hindi, English, Tamil, and Telugu.
            </p>
            <a href="/platform#multilingual" class="learn-link">Explore Languages ➔</a>
          </div>

          <div class="pillar-box card-light reveal-stagger-child">
            <div class="pillar-pill badge badge-indigo">Action Execution</div>
            <h3 class="pillar-box-title">Direct System Mutations</h3>
            <p class="pillar-box-desc">
              Turns voice dialogue into verified calendar bookings, WhatsApp media delivery, and real-time CRM updates without human latency.
            </p>
            <a href="/solutions" class="learn-link">Explore Solutions ➔</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Brief Solutions Spotlight -->
    <section class="section-wrapper" style="background: #FFFFFF; border-top: 1px solid rgba(30,32,51,0.06); border-bottom: 1px solid rgba(30,32,51,0.06);">
      <div class="container">
        <div class="spotlight-grid">
          <div class="spotlight-content reveal-fade-up">
            <div class="eyebrow-container" style="align-items: flex-start;">
              <p class="eyebrow-text" style="padding: 0;">INDUSTRY PLAYBOOKS</p>
              <div class="eyebrow-line" style="margin-left: 0;"></div>
            </div>
            <h2>Purpose-trained voice agents for every workflow.</h2>
            <p class="lead">
              From real estate site visits and healthcare scheduling to EMI recovery and high-volume customer care, deploy ready-to-run voice workers.
            </p>
            <div class="spotlight-actions">
              <a href="/solutions" class="btn btn-filled btn-lg">View Industry Solutions</a>
              <a href="/pricing" class="btn btn-outline btn-lg">Calculate ROI</a>
            </div>
          </div>

          <div class="spotlight-card card-dark reveal-fade-up">
            <div class="spotlight-card-head">
              <span class="pulse-dot"></span>
              <span>LIVE INDUSTRY SESSIONS</span>
            </div>
            <div class="spotlight-list">
              <div class="spotlight-item">
                <strong>Real Estate & Property</strong>
                <span>Lead qualification, budget parsing, site visit slot confirmation</span>
              </div>
              <div class="spotlight-item">
                <strong>Healthcare & Clinics</strong>
                <span>Doctor OPD scheduling, EHR sync, multilingual reminders</span>
              </div>
              <div class="spotlight-item">
                <strong>Banking & BFSI</strong>
                <span>Loan eligibility, payment recovery, KYC tokenization</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .pillars-3-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  .pillar-box {
    display: flex;
    flex-direction: column;
    padding: 2.25rem 2rem;
  }

  .pillar-pill {
    width: fit-content;
    margin-bottom: 1.25rem;
  }

  .pillar-box-title {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    color: #1E2033;
    margin-bottom: 0.6rem;
    line-height: 1.2;
  }

  .pillar-box-desc {
    font-size: 0.95rem;
    color: var(--sf-tx-secondary);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .learn-link {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--sf-tx-indigo);
    transition: transform 0.2s ease;
  }

  .learn-link:hover {
    transform: translateX(4px);
  }

  /* Spotlight */
  .spotlight-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3.5rem;
    align-items: center;
  }

  .spotlight-content h2 {
    font-size: clamp(2.2rem, 4vw, 3.25rem);
    color: #1E2033;
    margin-bottom: 1rem;
    line-height: 1.12;
  }

  .spotlight-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .spotlight-card {
    padding: 2rem;
  }

  .spotlight-card-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: #A5BBFC;
    font-weight: 700;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .spotlight-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .spotlight-item {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .spotlight-item strong {
    font-size: 0.92rem;
    color: #FFFFFF;
  }

  .spotlight-item span {
    font-size: 0.8rem;
    color: #94A3B8;
  }

  @media (max-width: 960px) {
    .pillars-3-grid {
      grid-template-columns: 1fr;
    }
    .spotlight-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
