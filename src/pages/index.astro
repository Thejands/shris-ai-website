---
import Layout from '../layouts/Layout.astro';
import Header from '../components/navigation/Header.astro';
import Footer from '../components/navigation/Footer.astro';
import Hero from '../components/hero/Hero.astro';
import MetricsStrip from '../components/hero/MetricsStrip.astro';
import AppDashboardShowcase from '../components/dashboard/AppDashboardShowcase.astro';
---

<Layout 
  title="Shris AI | Sovereign Enterprise AI Voice Platform"
  description="Built on sovereign voice compute engineered by Thejands LLP. Full-duplex conversational voice agents for inbound support, outbound qualification, and business workflow automations."
>
  <Header />

  <main id="main-content">
    <!-- Hero Section + Live 2-Way Voice Studio -->
    <Hero />

    <!-- Population-Scale Metrics Strip -->
    <MetricsStrip />

    <!-- 3 Sovereign Core Pillars -->
    <section class="section-wrapper below-fold" id="pillars">
      <div class="container">
        <div class="section-header reveal-fade-up">
          <div class="eyebrow-container">
            <div class="eyebrow-line"></div>
            <p class="eyebrow-text">Sovereign Enterprise Workforce</p>
            <div class="eyebrow-line"></div>
          </div>
          <h2>Voice intelligence built for India and the world.</h2>
          <p class="lead">
            A full-stack conversational voice runtime engineered for sub-300ms latency, Indian accents and code-mixing, and autonomous business system execution.
          </p>
        </div>

        <div class="pillars-3-grid">
          <div class="pillar-box card-light reveal-stagger-child">
            <div class="pillar-pill badge badge-indigo">Sovereign Voice Compute</div>
            <h3 class="pillar-box-title">Sub-300ms Full Duplex</h3>
            <p class="pillar-box-desc">
              Streaming acoustic models with instant barge-in interruption handling, zero awkward pauses, and natural vocal warmth.
            </p>
            <a href="/platform" class="learn-link">Explore Platform ➔</a>
          </div>

          <div class="pillar-box card-light reveal-stagger-child">
            <div class="pillar-pill badge badge-indigo">10+ Regional Languages</div>
            <h3 class="pillar-box-title">Dialects & Code-Mixing</h3>
            <p class="pillar-box-desc">
              Trained on real Indian speech patterns, regional inflections, and seamless switching between Hindi, English, Tamil, and Telugu.
            </p>
            <a href="/platform#multilingual" class="learn-link">Explore Languages ➔</a>
          </div>

          <div class="pillar-box card-light reveal-stagger-child">
            <div class="pillar-pill badge badge-indigo">Action Execution</div>
            <h3 class="pillar-box-title">Direct System Integrations</h3>
            <p class="pillar-box-desc">
              Turns voice dialogue into verified calendar bookings, WhatsApp media delivery, and real-time CRM updates without human latency.
            </p>
            <a href="/solutions" class="learn-link">Explore Solutions ➔</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Flagship Agentic Communications Dashboard Showcase -->
    <AppDashboardShowcase />

    <!-- Brief Solutions Spotlight -->
    <section class="section-wrapper below-fold" style="background: #FFFFFF; border-top: 1px solid rgba(15,23,42,0.06); border-bottom: 1px solid rgba(15,23,42,0.06);">
      <div class="container">
        <div class="spotlight-grid">
          <div class="spotlight-content reveal-fade-up">
            <div class="eyebrow-container" style="align-items: flex-start;">
              <p class="eyebrow-text" style="padding: 0;">Industry Playbooks</p>
              <div class="eyebrow-line" style="margin-left: 0;"></div>
            </div>
            <h2>Purpose-trained voice agents for every workflow.</h2>
            <p class="lead">
              From real estate site visits and healthcare scheduling to EMI recovery and high-volume customer care, deploy ready-to-run voice workers.
            </p>
            <div class="spotlight-actions">
              <a href="/solutions" class="btn btn-filled btn-lg">View Industry Solutions</a>
              <button data-open-demo class="btn btn-indigo btn-lg">Book a Demo</button>
            </div>
          </div>

          <div class="spotlight-card card-dark reveal-fade-up">
            <div class="spotlight-card-head">
              <span class="pulse-dot"></span>
              <span>Active Industry Workflows</span>
            </div>
            <div class="spotlight-list">
              <div class="spotlight-item">
                <strong>Real Estate & Property</strong>
                <span>Lead qualification, budget parsing, site visit slot confirmation</span>
              </div>
              <div class="spotlight-item">
                <strong>Healthcare & Clinics</strong>
                <span>Doctor OPD scheduling, EHR sync, multilingual reminders</span>
              </div>
              <div class="spotlight-item">
                <strong>Banking & BFSI</strong>
                <span>Loan eligibility, payment recovery, KYC tokenization</span>
              </div>
              <div class="spotlight-item">
                <strong>Education & EdTech</strong>
                <span>Admissions counselling, scholarship match, campus open house</span>
              </div>
              <div class="spotlight-item">
                <strong>Retail & E-commerce</strong>
                <span>COD confirmation, NDR recovery, prepaid conversion</span>
              </div>
              <div class="spotlight-item">
                <strong>Travel & Hospitality</strong>
                <span>Concierge, airport pickup, PMS special requests</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .pillars-3-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.75rem;
  }

  .pillar-box {
    display: flex;
    flex-direction: column;
    padding: 2.25rem 2rem;
  }

  .pillar-pill {
    width: fit-content;
    margin-bottom: 1.25rem;
  }

  .pillar-box-title {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--shris-navy-950);
    margin-bottom: 0.6rem;
    line-height: 1.2;
  }

  .pillar-box-desc {
    font-size: 0.95rem;
    color: var(--shris-tx-secondary);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .learn-link {
    font-size: 0.88rem;
    font-weight: 700;
    color: #4338CA;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: gap 0.2s ease;
  }

  .learn-link:hover {
    gap: 0.6rem;
  }

  /* Spotlight Grid */
  .spotlight-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .spotlight-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }

  .spotlight-card {
    padding: 2.25rem;
  }

  .spotlight-card-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: #A5BBFC;
    font-weight: 700;
    margin-bottom: 1.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .spotlight-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .spotlight-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .spotlight-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .spotlight-item strong {
    font-size: 1.05rem;
    color: #FFFFFF;
  }

  .spotlight-item span {
    font-size: 0.86rem;
    color: #94A3B8;
    line-height: 1.5;
  }

  @media (max-width: 960px) {
    .pillars-3-grid {
      grid-template-columns: 1fr;
    }
    .spotlight-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
