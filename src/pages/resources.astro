---
import Layout from '../layouts/Layout.astro';
import Header from '../components/navigation/Header.astro';
import Footer from '../components/navigation/Footer.astro';
---

<Layout 
  title="Resources & Research | Shris AI"
  description="Explore technical benchmarks, telephony architecture papers, and speech intelligence research by Thejands."
>
  <Header />

  <main id="main-content" style="padding-top: 5.5rem;">
    <section class="section-wrapper" style="text-align: center; padding-bottom: 2rem;">
      <div class="container container-narrow">
        <div class="eyebrow-container">
          <div class="eyebrow-line"></div>
          <p class="eyebrow-text">Technical Documentation & Research</p>
          <div class="eyebrow-line"></div>
        </div>
        <h1 style="font-size: clamp(2.4rem, 5.2vw, 4rem); color: var(--shris-navy-950); margin-bottom: 1.25rem;">
          Research, whitepapers, and benchmarks
        </h1>
        <p class="lead">
          Technical resources on low-latency streaming ASR, full-duplex neural voice synthesis, and carrier telephony architectures for the Indian sub-continent.
        </p>
      </div>
    </section>

    <!-- Whitepapers Grid -->
    <section class="section-wrapper" id="whitepapers" style="padding-top: 1rem;">
      <div class="container">
        <div class="grid-3">
          <div class="card-light">
            <span class="badge badge-indigo" style="margin-bottom: 1rem;">Whitepaper</span>
            <h3 style="font-size: 1.35rem; color: var(--shris-navy-950); margin-bottom: 0.5rem;">Sub-300ms Full-Duplex Voice Latency</h3>
            <p style="font-size: 0.88rem; color: var(--shris-tx-secondary); line-height: 1.6; margin-bottom: 1.25rem;">
              Analyzing turn-taking cadence, streaming chunk sizes, and speech acoustic models for natural conversational flow.
            </p>
            <a href="/developers" class="learn-link">Read Technical Paper ➔</a>
          </div>

          <div class="card-light">
            <span class="badge badge-emerald" style="margin-bottom: 1rem;">Benchmark</span>
            <h3 style="font-size: 1.35rem; color: var(--shris-navy-950); margin-bottom: 0.5rem;">Code-Mixed Hinglish & Dialects</h3>
            <p style="font-size: 0.88rem; color: var(--shris-tx-secondary); line-height: 1.6; margin-bottom: 1.25rem;">
              Comprehensive accuracy benchmarks across 10 Indian regional languages on real telephony audio recordings.
            </p>
            <a href="/platform#multilingual" class="learn-link">View Benchmarks ➔</a>
          </div>

          <div class="card-light">
            <span class="badge badge-indigo" style="margin-bottom: 1rem;">Architecture</span>
            <h3 style="font-size: 1.35rem; color: var(--shris-navy-950); margin-bottom: 0.5rem;">Carrier Telephony & SIP Trunking</h3>
            <p style="font-size: 0.88rem; color: var(--shris-tx-secondary); line-height: 1.6; margin-bottom: 1.25rem;">
              Multi-carrier SIP interconnects, jitter buffer optimizations, and OPUS compression over 2G/3G network conditions.
            </p>
            <a href="/platform" class="learn-link">View Architecture ➔</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
